flow OrchestratorSystem {
  summary: "Orchestrator-based agent system — deterministic tick loop that manages AI workers. Replaces the old Council/AgentManager/BridgeQueue with 5 modules: AgentDatabase, MessageBus, WorkerPool, OrgManager, Orchestrator."
  trigger: NodeBoot

  step boot -> create_db {
    actor: PandoNode
    what: "On node boot (full mode only), PandoNode.startAgentSystem() creates AgentDatabase (SQLite at ~/.pando/agents.db), MessageBus, WorkerPool, OrgManager."
  }

  step create_db -> create_council {
    actor: OrgManager
    what: "OrgManager.createOrchestrator() creates the council orchestrator — a top-level (level 0) persistent agent identity in AgentDatabase with role 'council'."
  }

  step create_council -> start_tick {
    actor: Orchestrator
    what: "Orchestrator(councilOrchId, deps) starts a deterministic tick loop (setInterval). Default: 60s for council. Each tick: read inbox → classify → decide → execute."
  }

  step start_tick -> tick_classify {
    actor: Orchestrator
    what: "classify() examines inbox messages. Tier 1 (~80%): deterministic actions (route task results, ack health alerts, check worker status). Tier 2 (~20%): needs AI judgment (new user request, complex health issue, architecture decision)."
    @gotcha("Tier 1 ticks use ZERO AI tokens. Only Tier 2 calls AIBackendRegistry.getBest().")
  }

  step tick_classify -> tick_execute {
    actor: Orchestrator
    what: "execute() processes OrchestratorAction[] from either deterministic() or callAI(). 12 action types: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, deploy, respond_to_user."
  }

  step tick_execute -> spawn_workers {
    actor: WorkerPool
    what: "WorkerPool.spawn() resolves agent template from TemplateRegistry, then creates or resumes a Claude Code child process. Injects a slim boot prompt (~500 tokens) with identity, task, and context API endpoints. Workers query /v1/context/* on demand for project architecture, lessons, and team state. Workers persist sessions — resumed for related tasks via SessionStrategy. Workers communicate via HTTP: GET /worker/:id/task, POST /worker/:id/report, GET /worker/:id/identity, GET /context/project, GET /context/lessons, GET /context/team, POST /context/discover."
    @gotcha("Workers are persistent team members, not disposable. Session IDs saved to SQLite. Resume workers for related tasks to preserve accumulated context. Only rotate when context is exhausted or domain changes.")
    @gotcha("Phase 105: Role prompts come from TemplateRegistry (SQLite agent_templates table), not hardcoded DEFAULT_ROLE_PROMPTS. Custom templates can be created via POST /v1/templates.")
  }

  step spawn_workers -> qa_cycle {
    actor: Orchestrator
    what: "Self-sustaining loop: Orchestrator spawns builder → builder reports completion → Orchestrator spawns QA tester (independent, gets ONLY task + diff) → QA passes → commit + deploy."
  }

  step qa_cycle -> deploy {
    actor: Orchestrator
    what: "QA PASS handler (Tier 1 deterministic): commit_code action → spawn devops agent. For projects: devops agent calls POST /v1/projects/:id/deploy and POST /v1/projects/:id/validate-deploy. For council: propose_upgrade → governance → broadcast to all nodes."
    @gotcha("Phase 105: Deployment is agent-driven. No hardcoded onDeploy callback. The devops agent calls the deploy API directly and reports back.")
  }

  step deploy -> governance {
    actor: Orchestrator
    what: "Council only: onPropose callback calls governance.createProposal(). In dev mode: auto-approve. Governance decisions route back via MessageBus as 'governance_decision' messages."
  }

  step governance -> reflection {
    actor: Orchestrator
    what: "reflectOnCompletion() called after task finishes. Extracts lessons from worker reports. High-confidence lessons promote to org_knowledge. Reflection levels: task → project → pattern → organization."
  }
}

concept OrchestratorAction {
  description: "Union type of 13 action types an orchestrator can take per tick: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, deploy (legacy/noop), respond_to_user, run_scenarios. Returned from deterministic() (Tier 1) or parseAIActions() (Tier 2)."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

concept AgentIdentity {
  description: "Unified SQLite record for every agent (worker or orchestrator). Fields: id, role, type, scope, parentId, nodeId, status, authority (JSON), fileScope, budget, tickIntervalMs, maxWorkers, rolePrompt, sessionId, templateId, createdAt, updatedAt. Phase 105: templateId links agent instance to its source template."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [AgentDatabase, OrgManager, WorkerPool, Orchestrator]
}

concept MessageBus {
  description: "SQLite-backed persistent message routing. Replaces in-memory BridgeQueue. Enforces communication boundaries: workers → parent only, orchestrators → parent/child/sibling, users → project orchestrator. Messages survive restarts."
  defined_in: "packages/node/src/core/message-bus.ts"
  used_by: [Orchestrator, PandoNode, PlatformApi]
}

concept WorkerPool {
  description: "Spawn/resume Claude Code worker processes. Manages child_process lifecycle with session persistence. buildBootPrompt() generates a slim ~500-token prompt — workers query /v1/context/* for project architecture, lessons, and discoveries on demand. Workers persist sessions in SQLite — resumed for related tasks, rotated when domain changes. Claude Code is a network resource: discovered via CapabilityProfile (shareCompute: true), not required on every node."
  defined_in: "packages/node/src/core/worker-pool.ts"
  used_by: [Orchestrator, AgentTools]
}

concept OrgManager {
  description: "Hierarchy management. createOrchestrator(), dissolve(), getTree(), getOrchestratorForProject(). Authority inheritance via narrowAuthority() — children can never exceed parent's authority. Max depth: 5."
  defined_in: "packages/node/src/platform/org-manager.ts"
  used_by: [PandoNode, Orchestrator, AgentTools]
}

concept AgentDatabase {
  description: "SQLite-backed storage with 8 tables: agent_identity, agent_templates, message_inbox, tick_log, lessons, org_knowledge, directives, reflections. Single file at ~/.pando/agents.db. WAL mode, prepared statements. Phase 105: agent_templates table stores reusable role definitions."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [MessageBus, WorkerPool, OrgManager, Orchestrator, AgentTools, PlatformApi, TemplateRegistry]
}

concept TierClassification {
  description: "Each orchestrator tick is classified as Tier 1 (deterministic, no AI call) or Tier 2 (needs AI judgment). Examples of Tier 1: route task_result, ack health_alert, check worker timeout. Examples of Tier 2: new user_request, complex escalation, reflection."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

decision THIN_AGENT_THICK_ORCHESTRATOR {
  context: "Old system had thick Agent class (1,279 lines) with complex state management. New system needed simpler orchestration with persistent workers."
  choice: "Persistent workers (session resume, context preservation) + thick orchestrator (deterministic tick loop, all state in SQLite). Claude Code is a discovered network resource, not a node requirement."
  why: "80% of orchestration is deterministic (routing, status checks). Only 20% needs AI. Workers persist sessions via SQLite — resumed for related tasks to preserve accumulated knowledge. Any node with Claude Code contributed (shareCompute: true) can run the council."
  date: "2026-02-27"
}

decision SQLITE_OVER_MEMORY {
  context: "BridgeQueue was in-memory. Messages lost on crash. State scattered across JSON files."
  choice: "Unified SQLite database (agents.db) for all agent state, messages, lessons, reflections."
  why: "Crash recovery. Single source of truth. WAL mode handles concurrent reads. No more scattered state files."
  date: "2026-02-27"
}

decision CLAUDE_CODE_AS_NETWORK_RESOURCE {
  context: "Council needs Claude Code to spawn workers. Not every node has it. Originally assumed council must run on same machine as Claude Code."
  choice: "Claude Code is a contributed network resource discovered via CapabilityProfile. Any node contributes via /contribute claude-code (sets shareCompute: true). Council discovers Claude Code nodes via P2P capability registry and routes work there. Council can run on ANY node that has Claude Code — doesn't matter which one."
  why: "Same model as MongoDB and API keys — not every node has it, the network discovers who does. Decouples council location from resource location. Multiple nodes can have Claude Code for redundancy."
  date: "2026-02-27"
}

decision PERSISTENT_WORKERS {
  context: "Workers were killed after each task. Next task on same codebase started from zero. Builder who just learned the storage layer gets deleted, replacement starts blind."
  choice: "Workers are persistent team members. Sessions saved to SQLite (sessionId). Resume via claude --continue --resume <sessionId> for related tasks. Rotate only when context exhausted or domain changes completely."
  why: "Workers accumulate valuable context — codebase understanding, file locations, gotchas discovered. Throwing this away is wasteful. Lessons in SQLite capture some knowledge, but a resumed session has the full mental model. Team members should persist."
  date: "2026-02-27"
}

decision PROJECT_ORCHESTRATOR_PIPELINE {
  context: "Phase 104. Council orchestrator worked for Pando infra. User app builds (build me X) created project in DB but no live orchestrator was spawned — dead end."
  choice: "Same Orchestrator class for both council and projects. Factory method instantiateOrchestrator() determines callbacks based on role. Project orchestrators get onCommit (git in workspace → GitHub push). Deployment is agent-driven: devops worker spawned after QA pass, calls deploy API directly. Workers run in project workspace dir, not Pando repo root."
  why: "Council is just Pando's own project manager. No special-casing. Same tick loop, same AI brain, same QA cycle. Only callbacks differ. Deployment through agents enables intelligent decision-making (t1 vs t2, troubleshooting, validation)."
  date: "2026-02-27"
}

decision AGENT_DRIVEN_DEPLOYMENT {
  context: "Phase 105. Deployment was a hardcoded onDeploy callback — just a fetch() to the deploy endpoint. No intelligence, no troubleshooting, no validation."
  choice: "Remove onDeploy callback. After QA passes, orchestrator spawns a devops worker with instructions to call POST /v1/projects/:id/deploy and POST /v1/projects/:id/validate-deploy. Devops agent reads template from TemplateRegistry, can think about the deploy, troubleshoot failures, validate post-deploy."
  why: "A callback can't decide 'this needs nginx config changes' or 'the last deploy failed, let me check logs'. An agent can. For simple deploys: agent makes the same HTTP call the callback did. For complex deploys: agent brings intelligence. Templates allow custom devops agents for different deployment environments."
  date: "2026-02-27"
}

decision TEAM_STATE_IN_PROJECT {
  context: "Phase 104. Need project team hierarchy and worker states to be portable and transparent."
  choice: "Export team-state.json v2 to project workspace on every commit. Contains: team blueprint (roles + templateIds), cumulative stats, lessons (with relevanceTags), reflections, active directives. Import on clone: lessons with 0.8x confidence decay, reflections, directives."
  why: "SQLite is structured and queryable. JSON export travels with the project repo. New node clones and reads it. Users see team structure in GitHub for transparency. v2 format enables full knowledge portability across nodes."
  date: "2026-02-27"
}

decision TEMPLATE_REGISTRY {
  context: "Phase 105. Agent roles were hardcoded as 5 strings in DEFAULT_ROLE_PROMPTS. Adding a new agent type (marketing, news, devops-specialist) required source code changes and redeployment."
  choice: "TemplateRegistry class backed by agent_templates SQLite table. Built-in templates seeded on boot (builder, tester, reviewer, researcher, devops). Custom templates created via POST /v1/templates. WorkerPool resolves templates at spawn time. Each agent instance links to its source template via template_id."
  why: "Agents are first-class network primitives. Templates are the reusable recipe; instances accumulate their own knowledge per-project. Same devops template → Facebook project learns Facebook patterns, Pando project learns Pando patterns. Schema has publisher_peer_id + version fields ready for future P2P sync and marketplace."
  date: "2026-02-27"
}

concept TemplateRegistry {
  description: "SQLite-backed agent template storage. Replaces hardcoded DEFAULT_ROLE_PROMPTS with data-driven templates. 5 built-in templates seeded on boot. Custom templates via API. Future: P2P sync via GossipSub."
  defined_in: "packages/node/src/platform/template-registry.ts"
  used_by: [WorkerPool, PandoNode, PlatformApi]
}
