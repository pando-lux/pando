flow OrchestratorSystem {
  summary: "Orchestrator-based agent system — deterministic tick loop that manages AI workers. Replaces the old Council/AgentManager/BridgeQueue with 5 modules: AgentDatabase, MessageBus, WorkerPool, OrgManager, Orchestrator."
  trigger: NodeBoot

  step boot -> create_db {
    actor: PandoNode
    what: "On node boot (full mode only), PandoNode.startAgentSystem() creates AgentDatabase (SQLite at ~/.pando/agents.db), MessageBus, WorkerPool, OrgManager."
  }

  step create_db -> create_council {
    actor: OrgManager
    what: "OrgManager.createOrchestrator() creates the council orchestrator — a top-level (level 0) persistent agent identity in AgentDatabase with role 'council'."
  }

  step create_council -> start_tick {
    actor: Orchestrator
    what: "Orchestrator(councilOrchId, deps) starts a deterministic tick loop (setInterval). Default: 60s for council. Each tick: read inbox → classify → decide → execute."
  }

  step start_tick -> tick_classify {
    actor: Orchestrator
    what: "classify() examines inbox messages. Tier 1 (~80%): deterministic actions (route task results, ack health alerts, check worker status). Tier 2 (~20%): needs AI judgment (new user request, complex health issue, architecture decision)."
    @gotcha("Tier 1 ticks use ZERO AI tokens. Only Tier 2 calls AIBackendRegistry.getBest().")
  }

  step tick_classify -> tick_execute {
    actor: Orchestrator
    what: "execute() processes OrchestratorAction[] from either deterministic() or callAI(). 12 action types: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, deploy, respond_to_user."
  }

  step tick_execute -> spawn_workers {
    actor: WorkerPool
    what: "WorkerPool.spawn() creates or resumes a Claude Code child process. Builds CLAUDE.md from 6 layers: constitution, role prompt, authority rules, lessons, tools, genome context. Workers persist sessions — resumed for related tasks via SessionStrategy ('resume' for same domain, 'rotate' for new domain, 'fresh' only when no prior session). Workers communicate via 3 HTTP endpoints (GET /worker/:id/task, POST /worker/:id/report, GET /worker/:id/identity)."
    @gotcha("Workers are persistent team members, not disposable. Session IDs saved to SQLite. Resume workers for related tasks to preserve accumulated context. Only rotate when context is exhausted or domain changes.")
  }

  step spawn_workers -> qa_cycle {
    actor: Orchestrator
    what: "Self-sustaining loop: Orchestrator spawns builder → builder reports completion → Orchestrator spawns QA tester (independent, gets ONLY task + diff) → QA passes → governance proposal → auto-approve in dev → commit."
  }

  step qa_cycle -> governance {
    actor: Orchestrator
    what: "onPropose callback calls governance.createProposal(). In dev mode: auto-approve. Governance decisions route back via MessageBus as 'governance_decision' messages."
  }

  step governance -> reflection {
    actor: Orchestrator
    what: "reflectOnCompletion() called after task finishes. Extracts lessons from worker reports. High-confidence lessons promote to org_knowledge. Reflection levels: task → project → pattern → organization."
  }
}

concept OrchestratorAction {
  description: "Union type of 12 actions an orchestrator can take per tick. Returned from either deterministic() (Tier 1) or parseAIActions() (Tier 2). Each action has a 'type' discriminator."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

concept AgentIdentity {
  description: "Unified SQLite record for every agent (worker or orchestrator). Fields: id, role, type, scope, parentId, nodeId, status, authority (JSON), fileScope, budget, tickIntervalMs, maxWorkers, rolePrompt, sessionId, createdAt, updatedAt."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [AgentDatabase, OrgManager, WorkerPool, Orchestrator]
}

concept MessageBus {
  description: "SQLite-backed persistent message routing. Replaces in-memory BridgeQueue. Enforces communication boundaries: workers → parent only, orchestrators → parent/child/sibling, users → project orchestrator. Messages survive restarts."
  defined_in: "packages/node/src/core/message-bus.ts"
  used_by: [Orchestrator, PandoNode, PlatformApi]
}

concept WorkerPool {
  description: "Spawn/resume Claude Code worker processes. Manages child_process lifecycle with session persistence. assembleContext() builds 6-layer CLAUDE.md (constitution, role, authority, lessons, tools, genome context). Workers persist sessions in SQLite — resumed for related tasks, rotated when domain changes. Claude Code is a network resource: discovered via CapabilityProfile (shareCompute: true), not required on every node."
  defined_in: "packages/node/src/core/worker-pool.ts"
  used_by: [Orchestrator, AgentTools]
}

concept OrgManager {
  description: "Hierarchy management. createOrchestrator(), dissolve(), getTree(), getOrchestratorForProject(). Authority inheritance via narrowAuthority() — children can never exceed parent's authority. Max depth: 5."
  defined_in: "packages/node/src/platform/org-manager.ts"
  used_by: [PandoNode, Orchestrator, AgentTools]
}

concept AgentDatabase {
  description: "SQLite-backed storage with 7 tables: agent_identity, message_inbox, tick_log, lessons, org_knowledge, directives, reflections. Single file at ~/.pando/agents.db. WAL mode, prepared statements."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [MessageBus, WorkerPool, OrgManager, Orchestrator, AgentTools, PlatformApi]
}

concept TierClassification {
  description: "Each orchestrator tick is classified as Tier 1 (deterministic, no AI call) or Tier 2 (needs AI judgment). Examples of Tier 1: route task_result, ack health_alert, check worker timeout. Examples of Tier 2: new user_request, complex escalation, reflection."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

decision THIN_AGENT_THICK_ORCHESTRATOR {
  context: "Old system had thick Agent class (1,279 lines) with complex state management. New system needed simpler orchestration with persistent workers."
  choice: "Persistent workers (session resume, context preservation) + thick orchestrator (deterministic tick loop, all state in SQLite). Claude Code is a discovered network resource, not a node requirement."
  why: "80% of orchestration is deterministic (routing, status checks). Only 20% needs AI. Workers persist sessions via SQLite — resumed for related tasks to preserve accumulated knowledge. Any node with Claude Code contributed (shareCompute: true) can run the council."
  date: "2026-02-27"
}

decision SQLITE_OVER_MEMORY {
  context: "BridgeQueue was in-memory. Messages lost on crash. State scattered across JSON files."
  choice: "Unified SQLite database (agents.db) for all agent state, messages, lessons, reflections."
  why: "Crash recovery. Single source of truth. WAL mode handles concurrent reads. No more scattered state files."
  date: "2026-02-27"
}

decision CLAUDE_CODE_AS_NETWORK_RESOURCE {
  context: "Council needs Claude Code to spawn workers. Not every node has it. Originally assumed council must run on same machine as Claude Code."
  choice: "Claude Code is a contributed network resource discovered via CapabilityProfile. Any node contributes via /contribute claude-code (sets shareCompute: true). Council discovers Claude Code nodes via P2P capability registry and routes work there. Council can run on ANY node that has Claude Code — doesn't matter which one."
  why: "Same model as MongoDB and API keys — not every node has it, the network discovers who does. Decouples council location from resource location. Multiple nodes can have Claude Code for redundancy."
  date: "2026-02-27"
}

decision PERSISTENT_WORKERS {
  context: "Workers were killed after each task. Next task on same codebase started from zero. Builder who just learned the storage layer gets deleted, replacement starts blind."
  choice: "Workers are persistent team members. Sessions saved to SQLite (sessionId). Resume via claude --continue --resume <sessionId> for related tasks. Rotate only when context exhausted or domain changes completely."
  why: "Workers accumulate valuable context — codebase understanding, file locations, gotchas discovered. Throwing this away is wasteful. Lessons in SQLite capture some knowledge, but a resumed session has the full mental model. Team members should persist."
  date: "2026-02-27"
}

decision PROJECT_ORCHESTRATOR_PIPELINE {
  context: "Phase 104. Council orchestrator worked for Pando infra. User app builds (build me X) created project in DB but no live orchestrator was spawned — dead end."
  choice: "Same Orchestrator class for both council and projects. Factory method instantiateOrchestrator() determines callbacks based on role. Project orchestrators get onCommit (git in workspace → GitHub push) and onDeploy (S3/PM2+nginx). Workers run in project workspace dir, not Pando repo root."
  why: "Council is just Pando's own project manager. No special-casing. Same tick loop, same AI brain, same QA cycle. Only callbacks differ."
  date: "2026-02-27"
}

decision TEAM_STATE_IN_PROJECT {
  context: "Phase 104. Need project team hierarchy and worker states to be portable and transparent."
  choice: "Export team-state.json to project workspace on every commit. Contains agent list (roles, sessions, status), lessons. Gets pushed to GitHub with project code."
  why: "SQLite is structured and queryable. JSON export travels with the project repo. New node clones and reads it. Users see team structure in GitHub for transparency."
  date: "2026-02-27"
}
