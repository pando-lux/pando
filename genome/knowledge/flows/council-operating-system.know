flow CouncilOperatingSystem {
  summary: "Phase 101: The Council Operating System — autonomous brain that observes, decides, acts, tests, heals, and communicates. Reads constitution, runs hourly reflections, spawns agents, gates deployments with adversarial QA, communicates with founder via gateway/TUI."
  trigger: NodeBoot

  step boot -> select_council {
    actor: Council
    what: "On node boot, Council selects top 3 AI-capable nodes by reputation from CapabilityRegistry. Rotates weekly. Stores state in ~/.pando/council/council-state.json."
  }

  step select_council -> reflection {
    actor: Council
    what: "Hourly (dev), 4h (beta), or daily (live) reflection cycle. Assembles prompt from: network-state.md, constitution.md, council-minutes.md, genome state, founder directives, health alerts, active governance proposals. Calls AIBackendRegistry.getBest() to run real AI reflection."
    @gotcha("Phase 101b: AI call is LIVE. Uses AIBackendRegistry.getBest('text-generation'). If no backend available, reflection is deferred (no crash). Output must be valid JSON matching ReflectionOutput interface.")
  }

  step reflection -> proposals {
    actor: Council
    what: "AI output parsed into: summary (health assessment), observations, proposals[] (governance proposals), actions[] (agent spawns). Each proposal submitted to governance with category 'council_action'."
  }

  step proposals -> auto_approve {
    actor: GovernanceSync
    what: "In dev mode: council_action proposals auto-approve immediately (veto model). In beta/live: standard governance voting applies per tier classification."
    @gotcha("Founder can veto any auto-approved proposal after the fact via POST /v1/council/veto/:id or TUI /council veto <id>.")
  }

  step auto_approve -> execute {
    actor: Council
    what: "Approved proposals trigger agent spawning: builder for code fixes, qa-adversarial for testing, devops for infrastructure repair. Results logged in council minutes."
  }

  step execute -> qa_gate {
    actor: Council
    what: "Phase 101d: Before deploying any fix, adversarial QA micro-agents test affected flows. Each agent knows NOTHING about the change — gets flow name, API URL, and QA memory briefing. Verdicts: PASS/FAIL/INCONCLUSIVE."
    @gotcha("QA agents test against STANDARD_FLOWS list. mapChangeToFlows() uses keyword heuristics to select relevant flows.")
  }

  step qa_gate -> deploy_or_block {
    actor: Council
    what: "Phase 101e: If all QA passes → governance proposal created (auto-approved in dev). If any FAIL → proposal blocked, failure logged in council minutes and QA memory."
  }

  step deploy_or_block -> heal {
    actor: Council
    what: "Phase 101e: Self-healing loop. HealthMonitor alerts route to council. Critical alerts trigger immediate reflection. Council spawns builder agents via POST /v1/agents/spawn. Full loop: detect → fix → QA → governance → deploy."
    @gotcha("Builder spawning is fire-and-forget. The council logs intent in minutes. Actual QA gating happens when builder reports back.")
  }
}

concept NetworkMode {
  description: "Phase 101: Three governance autonomy levels. 'dev' = founder veto model (auto-approve all, founder can reject). 'beta' = council votes + founder veto on critical. 'live' = fully autonomous (founder = regular participant)."
  defined_in: SharedTypes
  used_by: [GovernanceSync, Council, PandoNode, CliEntryPoint]
}

concept Constitution {
  description: "Phase 101: The foundational operating document all agents read as Layer 0 of their CLAUDE.md. Defines Two Laws, network mode, change tiers, agent charter, credential policy, safety invariants. Lives at genome/constitution.md. Amendments require governance_change category (80% approval, 24h vote)."
  defined_in: "genome/constitution.md"
  used_by: [Agent, Council, GovernanceSync]
}

concept ReflectionOutput {
  description: "Phase 101b: Structured JSON output from council AI reflection. Fields: summary (string), observations (string[]), proposals (array of {title, description, tier, category}), actions (array of {type, description, priority}). Parsed by Council.parseReflectionOutput() — handles raw JSON, markdown code blocks, and fallback to raw text."
  defined_in: "packages/node/src/platform/council.ts"
  used_by: [Council]
}

concept FounderDirective {
  description: "Phase 101b: Standing instructions from the founder injected into every council reflection prompt. Stored in council-state.json (max 20, FIFO). Added via Council.addFounderDirective(). Allows founder to guide council priorities without approving each action."
  defined_in: "packages/node/src/platform/council.ts"
  used_by: [Council]
}

concept CouncilTemplate {
  description: "Phase 101b: Agent template for council members at genome/templates/council.md. Defines council identity, authority boundaries (CAN/CANNOT), mandatory JSON output format, assessment priorities (safety > health > performance > growth > quality > evolution)."
  defined_in: "genome/templates/council.md"
  used_by: [Council, Agent]
}

concept QAMemory {
  description: "Phase 101d: Persistent store of past QA results at {dataDir}/council/qa-memory.json (max 500 entries, FIFO). Stores flow name, verdict (PASS/FAIL/INCONCLUSIVE), failure details, edge cases. getBriefing(flow) provides historical context to QA agents."
  defined_in: "packages/node/src/platform/qa-memory.ts"
  used_by: [Council]
}

concept AdversarialQA {
  description: "Phase 101d: Non-biased QA orchestration. Council.runAdversarialQA() spawns one AI agent per flow with ZERO context about what changed. Agent gets: flow name, API URL, QA memory briefing. Does NOT get: change description, source code. Returns PASS/FAIL/INCONCLUSIVE with evidence."
  defined_in: "packages/node/src/platform/council.ts"
  used_by: [Council]
}

concept SelfHealingLoop {
  description: "Phase 101e: Full autonomous fix loop. HealthMonitor alerts route to council via handleHealthAlert(). Critical alerts trigger immediate reflection. Council spawns builder agents via spawnFixAgent(). runSelfHealingLoop() orchestrates: detect → spawn builder → QA → governance → deploy."
  defined_in: "packages/node/src/platform/council.ts"
  used_by: [Council, HealthMonitor, PandoNode]
}

concept CouncilChat {
  description: "Phase 101c: Direct communication with the council. handleMessage() processes user messages via AI backend. Chat history persisted at {dataDir}/council/chat-history.json (max 200 entries). Accessible via POST /v1/council/message, GET /v1/council/chat, gateway /council page, TUI /council msg."
  defined_in: "packages/node/src/platform/council.ts"
  used_by: [Council, PlatformApi, TuiEntryPoint]
}

decision VETO_MODEL {
  context: "Phase 101: In dev mode, should the founder approve everything, or should everything auto-approve with founder having veto power?"
  choice: "Veto model — everything auto-approves, founder can reject after the fact"
  why: "Speed matters in dev. Approval model creates bottleneck. Veto model lets the council move fast while founder retains ultimate control."
  date: "2026-02-26"
}
