flow OrchestratorSystem {
  summary: "Orchestrator-based agent system — deterministic tick loop that manages AI workers. Replaces the old Council/AgentManager/BridgeQueue with 5 modules: AgentDatabase, MessageBus, WorkerPool, OrgManager, Orchestrator."
  trigger: NodeBoot

  step boot -> create_db {
    actor: PandoNode
    what: "On node boot (full mode only), PandoNode.startAgentSystem() creates AgentDatabase (SQLite at ~/.pando/agents.db), MessageBus, WorkerPool, OrgManager."
  }

  step create_db -> create_council {
    actor: OrgManager
    what: "OrgManager.createOrchestrator() creates the council orchestrator — a top-level (level 0) persistent agent identity in AgentDatabase with role 'council'."
  }

  step create_council -> start_tick {
    actor: Orchestrator
    what: "Orchestrator(councilOrchId, deps) starts a deterministic tick loop (setInterval). Default: 60s for council. Each tick: read inbox → classify → decide → execute."
  }

  step start_tick -> tick_classify {
    actor: Orchestrator
    what: "classify() examines inbox messages. Tier 1 (~80%): deterministic actions (route task results, ack health alerts, check worker status). Tier 2 (~20%): needs AI judgment (new user request, complex health issue, architecture decision)."
    @gotcha("Tier 1 ticks use ZERO AI tokens. Only Tier 2 calls AIBackendRegistry.getBest().")
  }

  step tick_classify -> tick_execute {
    actor: Orchestrator
    what: "execute() processes OrchestratorAction[] from either deterministic() or callAI(). 18 action types: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, respond_to_user, run_scenarios, delay_rotation, complete_directive, reject_directive, create_directive, record_qa_result."
  }

  step tick_execute -> spawn_workers {
    actor: WorkerPool
    what: "WorkerPool.spawn() resolves agent template from TemplateRegistry, then creates a new Claude Code child process. Each spawn creates a new Claude Code session with a full boot prompt (~500 tokens) containing identity, task, and context API endpoints. Workers do not resume previous sessions. Workers query /v1/context/* on demand for project architecture, lessons, and team state. Workers communicate via HTTP: GET /worker/:id/task, POST /worker/:id/report, GET /worker/:id/identity, GET /context/project, GET /context/lessons, GET /context/team, POST /context/discover."
    @gotcha("Workers are always fresh — each task gets a clean session. Lessons from previous sessions accumulate in SQLite and are injected via Context API, so knowledge is preserved without session resumption.")
    @gotcha("Phase 105: Role prompts come from TemplateRegistry (SQLite agent_templates table), not hardcoded DEFAULT_ROLE_PROMPTS. Custom templates can be created via POST /v1/templates.")
  }

  step spawn_workers -> qa_cycle {
    actor: Orchestrator
    what: "Self-sustaining loop: Orchestrator spawns builder → builder reports completion → Orchestrator spawns QA tester (independent, gets ONLY task + diff) → QA passes → commit + deploy."
  }

  step qa_cycle -> deploy {
    actor: Orchestrator
    what: "QA PASS handler (Tier 1 deterministic): commit_code action → spawn devops agent. For projects: devops agent calls POST /v1/projects/:id/deploy and POST /v1/projects/:id/validate-deploy. For council: propose_upgrade → governance → broadcast to all nodes."
    @gotcha("Phase 105: Deployment is agent-driven. No hardcoded onDeploy callback. The devops agent calls the deploy API directly and reports back.")
  }

  step deploy -> governance {
    actor: Orchestrator
    what: "Council only: onPropose callback calls governance.createProposal(). In dev mode: auto-approve. Governance decisions route back via MessageBus as 'governance_decision' messages."
  }

  step governance -> reflection {
    actor: Orchestrator
    what: "reflectOnCompletion() called after task finishes. Extracts lessons from worker reports. High-confidence lessons promote to org_knowledge. Reflection levels: task → project → pattern → organization."
  }
}

concept OrchestratorAction {
  description: "Union type of 18 action types an orchestrator can take per tick: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, respond_to_user, run_scenarios, delay_rotation, complete_directive, reject_directive, create_directive, record_qa_result. Returned from deterministic() (Tier 1) or parseAIActions() (Tier 2)."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

concept AgentIdentity {
  description: "Unified SQLite record for every agent (worker or orchestrator). Fields: id, role, type, scope, parentId, nodeId, status, authority (JSON), fileScope, budget, tickIntervalMs, maxWorkers, rolePrompt, sessionId, templateId, createdAt, updatedAt. Phase 105: templateId links agent instance to its source template."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [AgentDatabase, OrgManager, WorkerPool, Orchestrator]
}

concept MessageBus {
  description: "SQLite-backed persistent message routing. Replaces in-memory BridgeQueue. Enforces communication boundaries: workers → parent only, orchestrators → parent/child/sibling, users → project orchestrator. Messages survive restarts."
  defined_in: "packages/node/src/core/message-bus.ts"
  used_by: [Orchestrator, PandoNode, PlatformApi]
}

concept WorkerPool {
  description: "Spawn fresh Claude Code worker processes. Each task gets a clean session with full boot prompt (~500 tokens) — workers query /v1/context/* for project architecture, lessons, and discoveries on demand. Workers are always fresh; lessons from previous sessions accumulate in SQLite and are injected via Context API. Claude Code is a network resource: discovered via CapabilityProfile (shareCompute: true), not required on every node."
  defined_in: "packages/node/src/core/worker-pool.ts"
  used_by: [Orchestrator, AgentTools]
}

concept OrgManager {
  description: "Hierarchy management. createOrchestrator(), dissolve(), getTree(), getOrchestratorForProject(). Authority inheritance via narrowAuthority() — children can never exceed parent's authority. Max depth: 5."
  defined_in: "packages/node/src/platform/org-manager.ts"
  used_by: [PandoNode, Orchestrator, AgentTools]
}

concept AgentDatabase {
  description: "SQLite-backed storage with 11 tables: agent_identity, message_inbox, tick_log, lessons, org_knowledge, directives, reflections, agent_templates, project_discoveries, governance_audit, qa_test_runs. Single file at ~/.pando/agents.db. WAL mode, prepared statements. Phase 105: agent_templates table stores reusable role definitions. governance_audit table logs security gate results for each proposal. project_discoveries stores cross-worker knowledge sharing. qa_test_runs stores QA agent test results."
  defined_in: "packages/node/src/platform/agent-database.ts"
  used_by: [MessageBus, WorkerPool, OrgManager, Orchestrator, AgentTools, PlatformApi, TemplateRegistry]
}

concept GovernanceSecurityGate {
  description: "2 deterministic checks in validateUpgradeProposal() before auto-approve: (1) security file check — blocks proposals modifying sensitive files (credential-store, governance, guardrails, etc.) unless description mentions 'security' or 'credential', (2) kernel protection delay — 60s delay before approval for kernel/ file changes. Build and test verification happen in the orchestrator pre-commit pipeline, not in governance. Results logged to governance_audit table in AgentDatabase. Runs in dev mode only (< 8 peers)."
  defined_in: "packages/node/src/kernel/governance.ts"
  used_by: [GovernanceSync]
}

concept ObserverOrchestrator {
  description: "Autonomous observer agent (role='observer') created alongside council on boot. 5-min tick interval (tickIntervalMs: 300000). Always classified as Tier 2 (AI judgment). Proactively audits architecture, code quality, and system health. Reports findings as directives to council via MessageBus. Cannot spawn workers — observation and reporting only."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [PandoNode, Orchestrator]
}

concept TierClassification {
  description: "Each orchestrator tick is classified as Tier 1 (deterministic, no AI call) or Tier 2 (needs AI judgment). Examples of Tier 1: route task_result, ack health_alert, check worker timeout. Examples of Tier 2: new user_request, complex escalation, reflection."
  defined_in: "packages/node/src/platform/orchestrator.ts"
  used_by: [Orchestrator]
}

decision THIN_AGENT_THICK_ORCHESTRATOR {
  context: "Old system had thick Agent class (1,279 lines) with complex state management. New system needed simpler orchestration with fresh workers."
  choice: "Fresh workers (clean session per task, knowledge via Context API) + thick orchestrator (deterministic tick loop, all state in SQLite). Claude Code is a discovered network resource, not a node requirement."
  why: "80% of orchestration is deterministic (routing, status checks). Only 20% needs AI. Workers are always fresh — each spawn gets a clean session. Lessons from previous sessions accumulate in SQLite and are injected via Context API. Any node with Claude Code contributed (shareCompute: true) can run the council."
  date: "2026-02-27"
}

decision SQLITE_OVER_MEMORY {
  context: "BridgeQueue was in-memory. Messages lost on crash. State scattered across JSON files."
  choice: "Unified SQLite database (agents.db) for all agent state, messages, lessons, reflections."
  why: "Crash recovery. Single source of truth. WAL mode handles concurrent reads. No more scattered state files."
  date: "2026-02-27"
}

decision CLAUDE_CODE_AS_NETWORK_RESOURCE {
  context: "Council needs Claude Code to spawn workers. Not every node has it. Originally assumed council must run on same machine as Claude Code."
  choice: "Claude Code is a contributed network resource discovered via CapabilityProfile. Any node contributes via /contribute claude-code (sets shareCompute: true). Council discovers Claude Code nodes via P2P capability registry and routes work there. Council can run on ANY node that has Claude Code — doesn't matter which one."
  why: "Same model as MongoDB and API keys — not every node has it, the network discovers who does. Decouples council location from resource location. Multiple nodes can have Claude Code for redundancy."
  date: "2026-02-27"
}

decision FRESH_WORKERS {
  context: "Workers were initially made persistent with session resume. This added complexity (SessionStrategy, session tracking) without proportional benefit — Context API and lessons in SQLite provide knowledge continuity without stale session baggage."
  choice: "Workers are always fresh. Each spawn creates a new Claude Code session with a full boot prompt. Workers do not resume previous sessions. Lessons from previous sessions accumulate in SQLite and are injected into future workers via Context API (/v1/context/lessons, /v1/context/project)."
  why: "Fresh sessions avoid stale context accumulation, reduce complexity (no SessionStrategy or session tracking needed), and still preserve knowledge through the lessons/discoveries system in SQLite. Each task gets a clean mental model with relevant historical knowledge injected on demand."
  date: "2026-03-01"
}

decision PROJECT_ORCHESTRATOR_PIPELINE {
  context: "Phase 104. Council orchestrator worked for Pando infra. User app builds (build me X) created project in DB but no live orchestrator was spawned — dead end."
  choice: "Same Orchestrator class for both council and projects. Factory method instantiateOrchestrator() determines callbacks based on role. Project orchestrators get onCommit (git in workspace → GitHub push). Deployment is agent-driven: devops worker spawned after QA pass, calls deploy API directly. Workers run in project workspace dir, not Pando repo root."
  why: "Council is just Pando's own project manager. No special-casing. Same tick loop, same AI brain, same QA cycle. Only callbacks differ. Deployment through agents enables intelligent decision-making (t1 vs t2, troubleshooting, validation)."
  date: "2026-02-27"
}

decision AGENT_DRIVEN_DEPLOYMENT {
  context: "Phase 105. Deployment was a hardcoded onDeploy callback — just a fetch() to the deploy endpoint. No intelligence, no troubleshooting, no validation."
  choice: "Remove onDeploy callback. After QA passes, orchestrator spawns a devops worker with instructions to call POST /v1/projects/:id/deploy and POST /v1/projects/:id/validate-deploy. Devops agent reads template from TemplateRegistry, can think about the deploy, troubleshoot failures, validate post-deploy."
  why: "A callback can't decide 'this needs nginx config changes' or 'the last deploy failed, let me check logs'. An agent can. For simple deploys: agent makes the same HTTP call the callback did. For complex deploys: agent brings intelligence. Templates allow custom devops agents for different deployment environments."
  date: "2026-02-27"
}

decision TEAM_STATE_IN_PROJECT {
  context: "Phase 104. Need project team hierarchy and worker states to be portable and transparent."
  choice: "Export team-state.json v2 to project workspace on every commit. Contains: team blueprint (roles + templateIds), cumulative stats, lessons (with relevanceTags), reflections, active directives. Import on clone: lessons with 0.8x confidence decay, reflections, directives."
  why: "SQLite is structured and queryable. JSON export travels with the project repo. New node clones and reads it. Users see team structure in GitHub for transparency. v2 format enables full knowledge portability across nodes."
  date: "2026-02-27"
}

decision TEMPLATE_REGISTRY {
  context: "Phase 105. Agent roles were hardcoded as 5 strings in DEFAULT_ROLE_PROMPTS. Adding a new agent type (marketing, news, devops-specialist) required source code changes and redeployment."
  choice: "TemplateRegistry class backed by agent_templates SQLite table. Built-in templates seeded on boot (builder, tester, reviewer, researcher, devops). Custom templates created via POST /v1/templates. WorkerPool resolves templates at spawn time. Each agent instance links to its source template via template_id."
  why: "Agents are first-class network primitives. Templates are the reusable recipe; instances accumulate their own knowledge per-project. Same devops template → Facebook project learns Facebook patterns, Pando project learns Pando patterns. Schema has publisher_peer_id + version fields ready for future P2P sync and marketplace."
  date: "2026-02-27"
}

concept TemplateRegistry {
  description: "SQLite-backed agent template storage. Replaces hardcoded DEFAULT_ROLE_PROMPTS with data-driven templates. 5 built-in templates seeded on boot. Custom templates via API. Future: P2P sync via GossipSub."
  defined_in: "packages/node/src/platform/template-registry.ts"
  used_by: [WorkerPool, PandoNode, PlatformApi]
}

flow TickLifecycle {
  summary: "Single orchestrator tick: classify → readBoard → AI or deterministic → execute → markRead → logTick. Tier 1 = deterministic (no AI, ~2ms). Tier 2 = AI judgment (10-300s)."
  trigger: SetIntervalTick

  step tick_start -> read_board {
    actor: Orchestrator
    what: "readBoard() collects current state: inbox messages (categorized into workerReports, healthAlerts, userRequests, peerDisconnects, interruptedWorkers), active directives from SQLite, recently failed workers (last 15min), overdue workers, pending tasks, and worker counts."
  }

  step read_board -> health_check {
    actor: Orchestrator
    what: "runHealthMonitoring(board) — always runs (Tier 1). Checks worker health, peer connectivity. Deterministic, no AI call."
  }

  step health_check -> classify {
    actor: Orchestrator
    what: "classify(board) returns 1 or 2. Tier 1 when: (a) non-overdue workers active AND inbox empty (let them work), or (b) inbox empty, no directives, not a reflection tick. Tier 2 when: directives exist, reflection tick (every 5th), recently failed/overdue workers, or inbox has messages."
    @gotcha("Issue 6 guard: active non-overdue workers + empty inbox = Tier 1. Prevents burning Opus tokens while workers are busy.")
  }

  step classify -> decide {
    actor: Orchestrator
    what: "Tier 1: deterministic(board) returns actions directly (route results, ack alerts). Tier 2: callAI() sends boot prompt (first tick) or tick update (subsequent ticks) to session-persistent Opus brain. AI returns OrchestratorAction[] via 3-layer JSON parser."
    @gotcha("Tier 1 ticks use ZERO AI tokens. Idle ticks = zero cost.")
  }

  step decide -> execute {
    actor: Orchestrator
    what: "Execute OrchestratorAction[] array. 18 action types: spawn_worker, kill_worker, create_task, assign_task, send_message, create_team, dissolve_team, record_lesson, escalate, propose_upgrade, commit_code, respond_to_user, run_scenarios, delay_rotation, complete_directive, reject_directive, create_directive, record_qa_result."
  }

  step execute -> mark_read {
    actor: Orchestrator
    what: "messageBus.markRead(allMessageIds) — only if aiError is null. On AI failure, messages are preserved unread for retry on next tick. Agent lastReportAt updated."
    @gotcha("markRead guard: if AI call fails, messages stay unread so nothing is lost. Next tick retries.")
  }

  step mark_read -> log_tick {
    actor: Orchestrator
    what: "db.logTick() records: orchestratorId, tickNumber, tier, boardSnapshot (JSON), actionsExecuted (JSON), aiError if any. Every tick is logged for auditability."
  }
}

flow DirectiveFlow {
  summary: "Directives are persistent cross-agent standing orders stored in SQLite. Status lifecycle: pending → acknowledged → completed / rejected. They survive session rotations, node restarts, and crashes. Primary mechanism for Observer and QA agents to communicate findings to the council CEO. Never use send_message for findings that must persist — use create_directive instead."
  trigger: DirectiveCreation

  step create_directive -> store_sqlite {
    actor: PlatformApi_or_Orchestrator
    what: "Directives enter the system via two paths: (1) POST /v1/council/directive from a human operator (addedBy='operator'), or (2) create_directive action from another orchestrator (Observer, QA agent — addedBy=orchestratorId). Both insert into SQLite directives table. Schema columns: id (autoincrement), target_id (orchestrator ID or NULL for all), content (text), added_by (string), active (boolean, legacy compat), status ('pending'), times_seen (0), rejection_reason (null), acknowledged_at (null), completed_at (null), created_at (ISO timestamp)."
  }

  step store_sqlite -> read_in_tick {
    actor: Orchestrator
    what: "readBoard() calls db.getDirectives(orchestratorId) which queries: SELECT * FROM directives WHERE status IN ('pending', 'acknowledged', 'in_progress') AND (target_id=? OR target_id IS NULL). Returns array of { id, content, status, timesSeen, createdAt } — status-aware, not just active/inactive."
  }

  step read_in_tick -> classify_tier {
    actor: Orchestrator
    what: "classify() handles directives based on status. Pending directives (status='pending', never seen by AI) force Tier 2 — new orders always get AI attention. Overdue directives (timesSeen >= 5 without completion) also force Tier 2 with escalation. Acknowledged directives (already seen) ride along on natural Tier 2 ticks — they do not independently force a Tier 2 classification."
    @gotcha("Exception: if non-overdue workers are active AND inbox is empty, stays Tier 1 even with pending/overdue directives — avoids burning Opus tokens while workers are busy.")
  }

  step classify_tier -> ai_sees_directives {
    actor: Orchestrator
    what: "AI prompt includes '## Directives' section. Each directive shown as: [D#id] (seen Nx, Mmin old) [OVERDUE if timesSeen>=5]: content. New directives show '(NEW)'. OVERDUE directives show '**OVERDUE — ACT NOW OR REJECT WITH REASON**'. Prompt includes instructions for complete_directive and reject_directive JSON actions."
  }

  step ai_sees_directives -> acknowledge {
    actor: Orchestrator
    what: "After a successful Tier 2 tick (no AI error), all directives on the board are acknowledged via db.acknowledgeDirective(id). This: (1) transitions status from 'pending' to 'acknowledged' (if still pending), (2) increments times_seen counter, (3) sets acknowledged_at timestamp on first acknowledgment. Directives are NOT removed — they persist on the board."
  }

  step acknowledge -> complete_or_reject {
    actor: Orchestrator
    what: "AI returns complete_directive(id, summary) or reject_directive(id, reason) actions. complete_directive: sets status='completed', active=0, completed_at=now, stores summary. reject_directive: sets status='rejected', active=0, completed_at=now, stores reason. Completed/rejected directives are pruned from SQLite after 7 days. Directives persist across session rotations until explicitly completed or rejected — they NEVER disappear on their own."
    @gotcha("Directives are PERSISTENT. They appear in every tick's AI prompt until the AI explicitly completes or rejects them. This prevents directives from being silently ignored. The OVERDUE escalation (5+ ticks) ensures even low-priority directives eventually get addressed.")
  }

  step complete_or_reject -> cross_orchestrator {
    actor: Orchestrator
    what: "Cross-orchestrator communication via create_directive action: Observer creates directives targeted at the council CEO (e.g., '[OBSERVER GOVERNANCE] Priority: HIGH — ...'). QA agent creates directives for the CEO (e.g., '[QA BUG] Priority: HIGH — ...'). Any orchestrator can create directives for any other orchestrator by specifying targetId. This is the ONLY reliable way to communicate findings that must be acted on — send_message is fire-and-forget and gets lost after being read."
    @gotcha("Rule: NEVER use send_message for findings that must persist. Messages are read-once and pruned after 7 days. Directives persist until explicitly completed or rejected, survive session rotations and restarts, and escalate automatically when ignored.")
  }
}

flow SelfRestartProtocol {
  summary: "Safe self-restart watchdog detects stale compiled code and exits with code 75 for the process manager (systemd/PM2/start-node.bat) to restart."
  trigger: BuildCompletion

  step build_writes_stamp -> watchdog_check {
    actor: BuildScript
    what: "npm run build writes .build-commit file (git commit hash) to packages/node/dist/.build-commit and dist/.build-commit. This stamps which commit the compiled code corresponds to."
  }

  step watchdog_check -> compare_commits {
    actor: PandoNode
    what: "Watchdog runs every 5 minutes (setInterval, .unref()). Re-reads .build-commit from disk each cycle (upgrade catch-up may have rebuilt). Compares against git rev-parse HEAD."
  }

  step compare_commits -> check_workers {
    actor: PandoNode
    what: "If .build-commit !== HEAD, checks workerPool.getActiveWorkerCount(). If workers > 0, logs 'deferring restart' and waits for next cycle. Active workers are never interrupted."
    @gotcha("Restart is deferred while workers are active — never kills in-flight work.")
  }

  step check_workers -> exit_75 {
    actor: PandoNode
    what: "If .build-commit !== HEAD AND 0 active workers: process.exit(75). Exit code 75 is the RESTART_EXIT_CODE convention. start-node.bat (Windows) and systemd/PM2 (Linux) detect this code and restart the process."
  }

  step exit_75 -> process_manager_restart {
    actor: SystemD_PM2_Bat
    what: "Process manager restarts the node. New process loads the updated compiled code from dist/. Boot health check runs. Agent system rehydrates from SQLite."
  }
}

flow CouncilBoot {
  summary: "How the council orchestrator is created and started during node boot. Survives restarts via SQLite persistence."
  trigger: NodeBoot

  step node_start -> start_agent_system {
    actor: PandoNode
    what: "PandoNode._start() calls startAgentSystem() in full mode. Creates: AIBackendRegistry (detects Claude + Ollama), AgentDatabase (SQLite), MessageBus, GenomeBridge + GenomeBridgeRegistry, TemplateRegistry, WorkerPool, OrgManager."
  }

  step start_agent_system -> find_or_create_council {
    actor: PandoNode
    what: "Queries AgentDatabase for existing council orchestrator (role='council', type='orchestrator', status='pending' or 'active'). If found: rehydrate (set status='active'). If not found: OrgManager.createOrchestrator() with role='council', level=0, scope='public', tickInterval=60s, maxWorkers=10."
    @gotcha("Council identity survives restarts. Only created once — all subsequent boots rehydrate the existing record from SQLite.")
  }

  step find_or_create_council -> instantiate {
    actor: PandoNode
    what: "instantiateOrchestrator(councilOrchId) creates the Orchestrator instance. Factory method determines callbacks based on role: council gets onCommit (git commit + governance proposal), onRestart hooks."
  }

  step instantiate -> start_tick_loop {
    actor: Orchestrator
    what: "orch.start() begins setInterval tick loop (60s for council). First tick gets full boot prompt with instructions. Subsequent ticks get short board-state update. Session rotates every ~200 ticks."
  }

  step start_tick_loop -> rehydrate_projects {
    actor: PandoNode
    what: "After council boot, PandoNode also rehydrates persistent project orchestrators from DB (status='active' or 'pending'). Each gets its own instantiateOrchestrator() call with project-specific callbacks."
  }
}

flow WorkerReportFlow {
  summary: "How worker completion reports flow back to the orchestrator and trigger the next step in the self-sustaining loop."
  trigger: WorkerCompletion

  step worker_completes -> send_report {
    actor: Worker
    what: "Worker calls POST /v1/worker/:id/report with { status:'done'|'error', summary (3000 chars max) }. Auto-report also appends git diff stat. Report stored via messageBus.send() as type='worker_report' to parent orchestrator."
  }

  step send_report -> message_bus {
    actor: MessageBus
    what: "messageBus.send({ type:'worker_report', to: parentOrchId, payload: { status, summary, taskId, auto } }). Message persists in SQLite message_inbox table. Survives restarts."
  }

  step message_bus -> next_tick {
    actor: Orchestrator
    what: "Next tick: readBoard() categorizes messages. worker_report messages appear in board.workerReports. classify() returns Tier 2 (inbox not empty). AI reads the report in prompt context."
  }

  step next_tick -> ai_decides {
    actor: Orchestrator
    what: "AI evaluates the worker report. Decisions vary: builder reports done → spawn QA tester. QA reports PASS → commit_code + propose_upgrade. QA reports FAIL → spawn builder with failure details. Genome-updater reports done → commit .know changes."
    @gotcha("AI has session memory from previous ticks — it remembers what it asked the worker to do and can evaluate the report in context.")
  }

  step ai_decides -> execute_actions {
    actor: Orchestrator
    what: "AI returns OrchestratorAction[] (e.g., spawn_worker with tester role, or commit_code). Actions executed in order. The loop continues: builder → QA → commit → upgrade → next task."
  }
}
