flow ProjectPipeline {
  summary: "Phase 104: End-to-end flow for user app creation. Chat message → doorman classifies 'build' → project created → workspace initialized → project orchestrator instantiated → builder spawns → QA verifies → commit to workspace → push to GitHub → deploy to S3/nginx."
  trigger: UserChatMessage

  step user_message -> doorman {
    actor: User
    what: "User sends POST /v1/chat/message with 'build me a landing page'. No projectId."
  }

  step doorman -> classify {
    actor: ApiServer
    what: "doormanClassify() uses OpenAI gpt-4o-mini to determine intent. Returns 'build' with tier (1=static, 2=server) and description."
  }

  step classify -> create_project {
    actor: ProjectStore
    what: "projectStore.createProject() creates record in MongoDB (via P2P proxy for untrusted nodes). Assigns MongoDB + GitHub resources via preflight."
  }

  step create_project -> ensure_workspace {
    actor: PandoNode
    what: "ensureProjectWorkspace(projectId) creates ~/.pando/projects/<projectId>/, runs git init. If project has githubRepo, clones it first. Workers query /v1/context/project for architecture context on demand — no CLAUDE.md needed."
  }

  step ensure_workspace -> instantiate_orchestrator {
    actor: PandoNode
    what: "ensureProjectOrchestrator(projectId) calls OrgManager.getOrchestratorForProject() for DB record, then instantiateOrchestrator() for live instance. Factory wires project-scoped callbacks: onCommit (git in workspace → GitHub push), onDeploy (S3/PM2+nginx)."
    @gotcha("Same Orchestrator class as council. Only callbacks differ.")
  }

  step instantiate_orchestrator -> first_tick {
    actor: Orchestrator
    what: "Orchestrator.start() begins 30s tick loop. First tick reads user_request from MessageBus inbox. Tier 2 → calls AI to plan approach."
  }

  step first_tick -> spawn_builder {
    actor: Orchestrator
    what: "AI brain returns spawn_worker action with role='builder'. WorkerPool.spawn() creates Claude Code process in project workspace dir (not Pando repo root)."
    @gotcha("Worker cwd = config.workspaceDir (project workspace). Workers write files HERE, not in Pando root.")
  }

  step spawn_builder -> builder_works {
    actor: Worker
    what: "Builder receives slim boot prompt with task + context API endpoints. Queries /v1/context/project for architecture and discoveries, writes code, runs build, posts new discoveries via /v1/context/discover, reports 'done' via POST /v1/worker/:id/report."
  }

  step builder_works -> spawn_tester {
    actor: Orchestrator
    what: "Deterministic Tier 1: builder done → spawn tester worker. Tester gets ONLY task description + code diff. Independent verification."
  }

  step spawn_tester -> qa_pass {
    actor: Worker
    what: "Tester runs in same project workspace. Checks code quality, tests functionality, reports PASS or FAIL."
  }

  step qa_pass -> commit {
    actor: Orchestrator
    what: "Deterministic Tier 1: QA PASS → commit_code action. onCommit callback: exportTeamState() → git add -A → git commit in workspace → POST /projects/:id/github/push."
  }

  step commit -> deploy {
    actor: Orchestrator
    what: "After commit, orchestrator may trigger deploy action. onDeploy callback: POST /v1/projects/:id/deploy → P2P discovery → compute peer → S3 (tier 1) or PM2+nginx (tier 2)."
  }

  step deploy -> respond {
    actor: Orchestrator
    what: "respond_to_user action sends live URL via MessageBus → SSE to gateway."
  }
}

concept ProjectWorkspace {
  description: "Phase 104: Each user project gets a local directory at ~/.pando/projects/<projectId>/. Contains the project's git repo, team-state.json, and all source code. Workers run with cwd set to this directory. Context comes from /v1/context/project (genome if compiled, or auto-generated from package.json + file tree). On commit, pushed to GitHub as pando-lux/app-<id>-<name>."
  defined_in: "packages/node/src/index.ts"
  used_by: [PandoNode, Orchestrator, WorkerPool]
}

concept TeamStateExport {
  description: "Phase 104: JSON file (team-state.json) exported to project workspace on every commit. Contains agent list (id, role, status, sessionId, budgetSpent), lessons. Committed to git → pushed to GitHub → cloned by new nodes for resume. Enables transparency (users see team in GitHub) and continuity (new orchestrator reads previous state)."
  defined_in: "packages/node/src/index.ts"
  used_by: [PandoNode, Orchestrator]
}

concept OrchestratorFactory {
  description: "Phase 104: PandoNode.instantiateOrchestrator(orchId) is the unified factory for ALL orchestrators. Reads DB record, determines callbacks based on role (council → git in Pando repo + governance, project → git in workspace + GitHub push + deploy). Stores live instances in Map<string, Orchestrator>. Used by council startup, project creation, and rehydration on restart."
  defined_in: "packages/node/src/index.ts"
  used_by: [PandoNode]
}
