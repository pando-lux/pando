# Layer 2 — Platform Test Scenarios
# Migrated from legacy genome/flows/e2e-test-scenarios.md (Scenarios 22-28)
# Requires Layer 0 + Layer 1 healthy.

test SchedulerTaskLifecycle {
  description: "Submit task via POST /v1/tasks. Approve. Scheduler dequeues and executes. Status reaches 'completed'. 5 Lux earned."
  validates: SCHEDULER_EXECUTION
  type: e2e
  category: platform
  mode: 2
  nodes_required: "Windows"
  automatable: true
  steps: [
    "GET /v1/scheduler/status — scheduler running",
    "POST /v1/tasks with title, description, priority",
    "POST /v1/tasks/<id>/approve",
    "Poll GET /v1/tasks/<id> every 30s",
    "Wait for status: completed",
    "Check balance — 5 Lux earned for task completion"
  ]
  expected: "Task: pending → queued → in-progress → completed. 5 Lux emission."
  status: passing
  @gotcha("Task requires Claude Code on the executing node. Windows is the test target.")
}

test ResourceContribute {
  description: "Contribute OpenAI key. Appears in /v1/resources (key NOT exposed). Propagates to peers. 2 Lux earned."
  validates: RESOURCE_REGISTRY
  type: e2e
  category: platform
  mode: 2
  nodes_required: "Windows, EC2-1"
  automatable: true
  steps: [
    "GET /v1/resources — note current list",
    "POST /v1/resources/contribute with type=openai, key=sk-...",
    "Note resourceId",
    "GET /v1/resources — new resource appears (key NOT in response)",
    "GET /v1/resources on EC2-1 — resource visible (P2P sync)",
    "Check balance — 2 Lux earned"
  ]
  expected: "Resource created. Key NOT exposed in API. Propagates to peers. 2 Lux emission."
  status: passing
  @gotcha("Raw API key must NEVER appear in /resources response — security violation.")
}

test AISearchViaContributedKey {
  description: "POST /v1/search from LS-1 (untrusted). Routes to EC2-1 via P2P. AI response returned. No credential leak."
  validates: RESOURCE_ROUTING
  type: e2e
  category: platform
  mode: 3
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "POST /v1/search from LS-1 with query and tier=simple",
    "Verify response is AI-generated (not canned)",
    "Check response metadata for backend/resource used",
    "Verify LS-1 did NOT access API key directly"
  ]
  expected: "AI response within 30s. Routed via P2P to EC2-1. No credential in response."
  status: passing
}

test ContentPublishGossipSub {
  description: "Publish content from EC2-1. GossipSub propagates to LS-1 within 15s. Full-text search finds it on LS-1."
  validates: CONTENT_PROPAGATION
  type: e2e
  category: platform
  mode: 2
  nodes_required: "EC2-1, LS-1"
  automatable: true
  steps: [
    "POST /v1/content/publish from EC2-1 with title, body, tags",
    "Note contentId",
    "Wait 15s for GossipSub propagation",
    "GET /v1/content/search?q=<title> on LS-1 — content found",
    "GET /v1/content/<id> on LS-1 — full content retrieved"
  ]
  expected: "Content propagated via GossipSub within 15s. FTS5 search works on LS-1."
  status: passing
}

test ContentSearchMultiNode {
  description: "Publish unique content from EC2-1 and EC2-2. Search from LS-1 returns results from BOTH sources."
  validates: CONTENT_PROPAGATION
  type: e2e
  category: platform
  mode: 2
  nodes_required: "EC2-1, EC2-2, LS-1"
  automatable: true
  steps: [
    "POST /v1/content/publish from EC2-1: 'Content-From-EC21'",
    "POST /v1/content/publish from EC2-2: 'Content-From-EC22'",
    "Wait 30s",
    "GET /v1/content/search?q=Content-From on LS-1",
    "Verify results include content from BOTH EC2-1 and EC2-2"
  ]
  expected: "Search returns content from multiple source nodes. FTS5 partial match works."
  status: passing
}

test ProjectCRUD {
  description: "Create project, list, get, update, delete. Post-delete GET returns 404. All via MongoDB backend."
  validates: PROJECT_MANAGEMENT
  type: e2e
  category: platform
  mode: 3
  nodes_required: "EC2-1"
  automatable: true
  steps: [
    "POST /v1/projects — create with name, description",
    "GET /v1/projects — project in list",
    "GET /v1/projects/<id> — details correct",
    "PATCH /v1/projects/<id> — update description",
    "DELETE /v1/projects/<id>",
    "GET /v1/projects/<id> — expect 404"
  ]
  expected: "Full CRUD lifecycle. Data in MongoDB. 404 after delete."
  status: passing
}

test ChatManagerAgentResponds {
  description: "POST /v1/chat/message. Manager agent receives via bridge queue, processes, responds. Response in chat history."
  validates: CHAT_FLOW
  type: e2e
  category: platform
  mode: 2
  nodes_required: "Windows"
  automatable: false
  steps: [
    "POST /v1/chat/message with test message",
    "Note messageId and threadId",
    "Wait 2-3 minutes for manager agent response",
    "GET /v1/chat/history — response appears",
    "Verify order: user message → agent response"
  ]
  expected: "Message accepted. Manager processes via bridge. Response in history within 3 min."
  status: passing
  @gotcha("Response time depends on Claude Code. May take 1-3 minutes.")
}
