# Regression API Tests
# Source: packages/node/src/platform/regression-suite.ts (14 built-in tests)
# These are automated HTTP-level checks. All automatable.

test RegStatusEndpoint {
  description: "GET /v1/status returns 200 with peerId, uptime, peers fields."
  validates: API_HEALTH
  type: regression
  category: api
  automatable: true
  method: GET
  path: "/v1/status"
  expectedStatus: 200
  expectedFields: ["peerId", "uptime", "peers"]
  status: passing
}

