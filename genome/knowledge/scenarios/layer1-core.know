# Layer 1 — Core Test Scenarios
# Migrated from legacy genome/flows/e2e-test-scenarios.md (Scenarios 12-21, 30-33, 34-37, 41)
# Requires Layer 0 healthy.

test AgentSpawn {
  description: "POST /v1/agents/spawn creates builder agent. Agent appears in /agents/tree. Workspace + CLAUDE.md created."
  validates: AGENT_LIFECYCLE
  type: e2e
  category: core
  mode: 2
  nodes_required: "Windows"
  automatable: true
  steps: [
    "POST /v1/agents/spawn with role=builder",
    "Note agentId from response",
    "GET /v1/agents/tree — agent appears",
    "Verify workspace dir exists at ~/.pando/agents/<agentId>/",
    "GET /v1/agents/<agentId>/status — shows idle or working"
  ]
  expected: "Agent created with ID. Appears in tree. Workspace + CLAUDE.md exist."
  status: passing
  @gotcha("Requires Claude Code installed on the target node.")
}

test AgentResume {
  description: "Restart node. In-progress agents resume with same sessionId via Claude Code --continue --resume."
  validates: AGENT_LIFECYCLE
  type: e2e
  category: core
  mode: 2
  nodes_required: "Windows"
  automatable: true
  steps: [
    "Spawn agent, assign task",
    "Wait for agent to reach WORKING state",
    "Note agent sessionId",
    "Restart node",
    "GET /v1/agents/tree — agent still present",
    "Verify agent resumes with same sessionId"
  ]
  expected: "Agent persists across restart. Resumes mid-task with same sessionId."
  status: passing
}

test AgentMessageProcessing {
  description: "Send message to idle agent. Agent transitions to WORKING, processes message, sends response via bridge."
  validates: AGENT_LIFECYCLE
  type: e2e
  category: core
  mode: 2
  nodes_required: "Windows"
  automatable: false
  steps: [
    "Spawn fresh agent",
    "POST /v1/agents/<id>/message with test prompt",
    "Wait 60s for Claude Code response",
    "Check agent status for response",
    "Verify bridge event fires with response"
  ]
  expected: "Message queued. Agent transitions to WORKING. Response delivered via bridge."
  status: passing
  @gotcha("Response time depends on Claude Code session startup. May take 30-90s.")
}

test StorageMongoDBDirect {
  description: "EC2-1 (MongoDB): create thread, add message, read back. Persists across node restart."
  validates: STORAGE_DURABILITY
  type: e2e
  category: core
  mode: 3
  nodes_required: "EC2-1"
  automatable: true
  steps: [
    "Verify EC2-1 capabilities show storageBackend: mongodb",
    "POST /v1/threads — create thread, note threadId",
    "POST /v1/threads/<id>/messages — add message",
    "GET /v1/threads/<id>/messages — read back",
    "Restart EC2-1 via systemctl",
    "Wait 30s",
    "GET /v1/threads/<id>/messages — still present (durable in MongoDB)"
  ]
  expected: "Thread + message persist across restart. Stored in MongoDB, not RAM."
  status: passing
}

test StorageP2PProxy {
  description: "LS-1 (untrusted, no MongoDB): create thread via P2P proxy to EC2-1. Thread visible on both nodes."
  validates: P2P_STORAGE_PROXY
  type: e2e
  category: core
  mode: 2
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "Verify LS-1 capabilities show storageBackend: p2p",
    "POST /v1/threads from LS-1 — proxied to EC2-1",
    "Note threadId",
    "GET /v1/threads/<id> from LS-1 — returns data",
    "GET /v1/threads/<id> from EC2-1 — same data",
    "POST /v1/threads/<id>/messages from LS-1",
    "GET messages from EC2-1 — message present"
  ]
  expected: "Thread created via P2P proxy. Visible on both LS-1 and EC2-1."
  status: passing
  @gotcha("P2PStorageBackend has 15s timeout per request. Slight latency vs direct MongoDB.")
}

test DeployTier1S3 {
  description: "Deploy static site from LS-1 → P2P discovery → EC2-1 handles git clone + S3 upload. S3 URL returns 200."
  validates: DEPLOY_TIER1
  type: e2e
  category: core
  mode: 3
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "POST /v1/projects on LS-1 (tier 1)",
    "POST /v1/projects/<id>/deploy from LS-1",
    "Verify P2P discovery routes to EC2-1",
    "Check response for S3 URL",
    "HTTP GET the S3 URL — expect 200 with HTML"
  ]
  expected: "S3 URL returns 200. Deploy proxied via P2P to EC2-1."
  status: passing
  @gotcha("EC2-1 must have AWS credentials contributed. S3 bucket must be public.")
}

test DeployTier2PM2Nginx {
  description: "Deploy dynamic app from LS-1 → EC2-1. PM2 process running, nginx reverse proxy configured. URL returns 200."
  validates: DEPLOY_TIER2
  type: e2e
  category: core
  mode: 3
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "POST /v1/projects on LS-1 (tier 2)",
    "POST /v1/projects/<id>/deploy from LS-1",
    "Check response for publicAddress URL",
    "HTTP GET the URL — expect 200",
    "SSH EC2-1: pm2 list — app running",
    "SSH EC2-1: ls /etc/nginx/pando-apps/ — config exists"
  ]
  expected: "URL returns 200. PM2 process running. nginx config exists."
  status: passing
}

test UndeployTier2 {
  description: "Undeploy Tier 2 app. URL returns 404. PM2 entry removed. nginx config deleted. deployPeerId cleared."
  validates: DEPLOY_TIER2
  type: e2e
  category: core
  mode: 3
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "Confirm app running (URL returns 200)",
    "POST /v1/projects/<id>/undeploy from LS-1",
    "Wait 10s",
    "HTTP GET URL — expect 404",
    "SSH EC2-1: pm2 list — app gone",
    "SSH EC2-1: nginx config file deleted",
    "GET /v1/projects/<id> — deployPeerId cleared"
  ]
  expected: "URL 404. PM2 removed. nginx cleaned. Project record cleared."
  status: passing
}

test AuthJWTCrossNode {
  description: "Login on EC2-1, get JWT. Use same JWT on EC2-2 — accepted (stateless Ed25519 verification). Invalid token rejected."
  validates: AUTH_STATELESS_JWT
  type: e2e
  category: core
  mode: 2
  nodes_required: "EC2-1, EC2-2"
  automatable: true
  steps: [
    "POST /auth/login on EC2-1 (pando/KalaJi99@)",
    "Note JWT token",
    "Use token on EC2-1 — 200 OK",
    "Use same token on EC2-2 — 200 OK (cross-node)",
    "Use 'INVALID-TOKEN' — 401",
    "Verify JWT is stateless (no DB lookup on EC2-2)"
  ]
  expected: "JWT accepted cross-node. Invalid token rejected. Stateless verification."
  status: passing
  @gotcha("EC2-2 extracts public key from iss peerId — no ledger lookup needed.")
}

test UpgradeProtocol {
  description: "POST /v1/upgrade on LS-1 triggers git pull → build → restart. Node comes back with updated code."
  validates: SELF_UPGRADE
  type: e2e
  category: core
  mode: 3
  nodes_required: "LS-1"
  automatable: false
  steps: [
    "Record current version from GET /v1/status",
    "POST /v1/upgrade on LS-1",
    "Wait 3-5 minutes for git pull + build + restart",
    "GET /v1/status — node back online",
    "Verify version updated"
  ]
  expected: "Node pulls, builds, restarts via PM2. Comes back with new code."
  status: passing
  @gotcha("Build may fail if node_modules perms are wrong. Fallback: sudo -u pando npm run build via SSH.")
}

test MongoDBDownGracefulDegradation {
  description: "Stop EC2-1 (MongoDB node). LS-1 thread creation fails gracefully (not crash). Layer 0 still works."
  validates: GRACEFUL_DEGRADATION
  type: e2e
  category: core
  mode: 2
  nodes_required: "LS-1, EC2-1"
  automatable: true
  steps: [
    "Stop EC2-1 via systemctl",
    "Wait 30s",
    "POST /v1/threads from LS-1 — expect degraded error, not crash",
    "GET /v1/status on LS-1 — still responds",
    "GET /v1/balance on LS-1 — ledger still works",
    "Restart EC2-1",
    "Wait 30s — POST /v1/threads from LS-1 works again"
  ]
  expected: "Thread creation fails with degraded message. Node responsive at Layer 0. Auto-recovers when EC2-1 returns."
  status: passing
}

test AgentSystemDownP2PSurvives {
  description: "Kill agent child processes. Node process survives. P2P + ledger still functional."
  validates: LAYER_ISOLATION
  type: e2e
  category: core
  mode: 2
  automatable: false
  steps: [
    "Verify agent system running via GET /v1/agents/tree",
    "Kill all Claude Code child processes",
    "GET /v1/status — still responds",
    "GET /v1/balance — ledger works",
    "GET /v1/peers — P2P connected",
    "POST /v1/agents/spawn — returns 503 or queued"
  ]
  expected: "Node survives agent crash. Layer 0 unaffected. Agent spawn returns 503."
  status: passing
  @gotcha("Do NOT taskkill all claude.exe on your own machine — kills your session.")
}

test EC2UnreachableDeployFailsGracefully {
  description: "EC2-1 stopped. Deploy from LS-1 returns clear 503 error. Node continues running."
  validates: GRACEFUL_DEGRADATION
  type: e2e
  category: core
  mode: 2
  nodes_required: "LS-1"
  automatable: true
  steps: [
    "Stop EC2-1",
    "Wait 30s",
    "POST /v1/projects/<id>/deploy from LS-1",
    "Expect 503: 'No compute peer available'",
    "GET /v1/status on LS-1 — still responsive"
  ]
  expected: "Deploy returns 503 with clear error. LS-1 continues running."
  status: passing
}

test StorageFailover {
  description: "Stop EC2-1. LS-1 auto-fails over to EC2-2. New thread created via EC2-2. No data loss."
  validates: STORAGE_FAILOVER
  type: e2e
  category: core
  mode: 2
  nodes_required: "LS-1, EC2-1, EC2-2"
  automatable: true
  steps: [
    "Create thread from LS-1 (routed to EC2-1), note threadId",
    "Stop EC2-1",
    "Wait 30s for failover",
    "Create NEW thread from LS-1 — should route to EC2-2",
    "Verify new thread on EC2-2",
    "Restart EC2-1",
    "Verify original thread still on EC2-1"
  ]
  expected: "Writes auto-routed to EC2-2 within 30s. No LS-1 restart needed. No data loss."
  status: passing
  @gotcha("P2PStorageBackend auto-detects available peers. Failover takes ~30s for timeout + reconnect.")
}

test ClaudeBackendDetect {
  description: "GET /v1/capabilities shows aiBackends.claude-code.available: true on Windows (has Claude Code)."
  validates: AI_BACKEND_REGISTRY
  type: e2e
  category: core
  mode: 1
  nodes_required: "Windows"
  automatable: true
  steps: [
    "GET /v1/capabilities on Windows",
    "Check aiBackends.claude-code — available: true",
    "Check aiBackends.ollama — available: false (not installed)"
  ]
  expected: "Claude Code detected as available. Ollama detected as unavailable."
  status: passing
}

test OllamaBackendDetectUnavailable {
  description: "On node without Ollama, aiBackends.ollama shows available: false with human-readable reason."
  validates: AI_BACKEND_REGISTRY
  type: e2e
  category: core
  mode: 1
  automatable: true
  steps: [
    "GET /v1/capabilities on EC2-1 (no Ollama)",
    "Check aiBackends.ollama — available: false",
    "Verify reason string is human-readable"
  ]
  expected: "ollama key present, available: false, reason explains why."
  status: passing
}

test AgentUsesBackendRegistry {
  description: "Spawned agent uses AIBackendRegistry.getBest(). Task completes via claude-code backend."
  validates: AI_BACKEND_REGISTRY
  type: e2e
  category: core
  mode: 2
  nodes_required: "Windows"
  automatable: false
  steps: [
    "Spawn agent on Windows",
    "Assign simple task",
    "Verify task completes",
    "Check logs/metadata for backend: claude-code"
  ]
  expected: "Agent uses registry interface, not hardcoded claude -p. Backend recorded."
  status: passing
}

test BackendFallbackOrGracefulError {
  description: "Primary backend fails. If fallback available, use it. If not, return 503 (not crash/hang)."
  validates: AI_BACKEND_REGISTRY
  type: e2e
  category: core
  mode: 2
  automatable: false
  steps: [
    "Simulate Claude Code failure (rename binary or mock error)",
    "Spawn agent — expect fallback or 503",
    "Restore Claude Code",
    "Spawn agent — uses primary again"
  ]
  expected: "Clean 503 if no fallback. Registry re-detects primary after restore."
  status: passing
  @gotcha("Backend simulation is manual. Can't easily automate binary rename on all OS.")
}

test CrossNodeAgentP2PStorage {
  description: "Agent on LS-1 creates thread via local API. P2PStorageBackend proxies to EC2-1. Thread visible on EC2-1."
  validates: P2P_STORAGE_PROXY
  type: e2e
  category: core
  mode: 2
  nodes_required: "LS-1, EC2-1"
  automatable: false
  steps: [
    "Spawn agent on LS-1",
    "Agent creates thread via http://localhost:4000/threads",
    "Wait for agent to complete",
    "Verify thread on EC2-1 (proxied via P2P)",
    "Agent doesn't know about EC2-1 — transparent proxy"
  ]
  expected: "Agent writes via local API. P2P proxies to EC2-1. Thread in MongoDB."
  status: passing
}
