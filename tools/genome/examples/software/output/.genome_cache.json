          "_source": "flows.know",
          "rule": "OverlayCache must be empty before any audio starts playing",
          "applies_to": [
            "FrontendHandler",
            "AnimationRenderer"
          ],
          "enforced_by": "test_cache_clear_before_audio",
          "severity": "critical"
        },
        {
          "_type": "invariant",
          "_name": "AUDIO_BEFORE_FRAMES",
          "_source": "flows.know",
          "rule": "Audio socket message must be emitted before any frame messages",
          "applies_to": [
            "AnimationRenderer"
          ],
          "enforced_by": "test_av_emit_order",
          "severity": "critical"
        },
        {
