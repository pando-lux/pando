    "knowledge.know": {
      "mtime": 1771587264.0914197,
      "nodes": [
        {
          "_type": "concept",
          "_name": "AudioVideoSyncPrinciple",
          "_source": "knowledge.know",
          "_tags": [
            "@why(\"This principle is why the emit order in AnimationRenderer is non-negotiable, not just a convention\")"
          ],
          "domain": "av_perception",
          "explains": [
            "AnimationRenderer",
            "FrontendHandler"
          ],
          "summary": "Audio is the perceptual anchor \u2014 the brain locks time to audio, not video",
          "why_audio_first": "Human perception is audio-anchored. When audio and video are misaligned, the brain perceives video as wrong, not audio. Consequence: audio socket message MUST be emitted before frame messages.",
          "key_values": {
            "audio_leads_0_to_50ms": "imperceptible \u2014 brain accepts as simultaneous",
            "audio_lags_any_amount": "immediately noticeable as 'out of sync'",
            "video_lags_up_to_200ms": "tolerated because brain adjusts lip-read expectation"
          },
          "see_also": [
            "AV_DESYNC_001",
            "AUDIO_BEFORE_FRAMES"
          ]
        },
        {
          "_type": "concept",
          "_name": "AsyncCacheContention",
          "_source": "knowledge.know",
          "_tags": [
            "@why(\"This is why clearOverlayCache MUST be awaited \u2014 not just best practice, but async mechanics guarantee wrong behavior if not awaited\")"
          ],
          "domain": "concurrent_state",
          "explains": [
            "OverlayCache",
            "FrontendHandler"
          ],
          "summary": "Async cache operations can return before completion \u2014 partial state causes cross-message contamination",
          "why_await_required": "JavaScript async functions return a Promise immediately. Without await, the caller continues while cache ops are still running. If a new message starts before the old cache is cleared, old overlay sprites bleed into the new render \u2014 visible as ghost frames from the previous message.",
          "key_values": {
            "partial_clear_symptom": "previous message lip shape visible for 1-3 frames at start of new message",
            "full_clear_symptom": "clean transition, no ghost frames",
            "detection": "add logging in clearOverlayCache() to confirm completion before returning"
          },
          "see_also": [
            "CACHE_RACE_001",
            "CACHE_BEFORE_AUDIO"
          ]
        },
        {
          "_type": "concept",
          "_name": "PhonemeAlignmentCompleteness",
          "_source": "knowledge.know",
          "domain": "speech_synthesis",
          "explains": [
            "TTSService",
            "AnimationRenderer"
          ],
          "summary": "TTS alignment APIs stream results \u2014 final phonemes arrive last and are most likely to be cut off",
          "why_completeness_check": "ElevenLabs streams phoneme alignment as audio is generated. The final 2-3 phonemes of a sentence arrive in the last response chunk. If animation starts on first chunk arrival, the lip sync pipeline runs without the sentence's ending \u2014 producing wrong mouth shape for the last word.",
          "key_values": {
            "streaming_risk": "last 2-3 phonemes of sentence",
            "safe_start_condition": "alignment.is_complete == true (full sentence confirmed)",
            "typical_alignment_latency": "200ms after audio generation starts"
          },
          "see_also": [
            "ALIGNMENT_PARTIAL_001"
          ]
        },
        {
          "_type": "constant",
          "_name": "MAX_RETRY_COUNT",
          "_source": "knowledge.know",
          "value": 3,
          "unit": "attempts",
          "file": "src/handler.py:28",
          "calibrates": "FrontendHandler",
          "why": "Exponential backoff 3x = total max wait of 7 seconds (1s + 2s + 4s). Beyond 7s the user has already re-submitted the message, causing a duplicate. Below 3 the system gives up on transient network errors too early.",
          "valid_range": "2 to 5",
          "recalibrate_when": "p99 latency exceeds 3s (current baseline: 800ms)",
          "derived_from": "CACHE_RACE_001"
        },
        {
          "_type": "constant",
          "_name": "TTS_ALIGNMENT_POLL_INTERVAL_MS",
          "_source": "knowledge.know",
          "value": 50,
          "unit": "milliseconds",
          "file": "src/processor.py:64",
          "calibrates": "TTSService",
          "why": "50ms poll interval catches alignment completion within one animation frame (33ms at 30fps). Polling faster than 33ms wastes CPU with no benefit. Polling slower than 100ms risks missing the is_complete flag and adding a full frame of desync.",
          "valid_range": "33 to 100",
          "recalibrate_when": "animation frame rate changes from 30fps",
          "derived_from": "ALIGNMENT_PARTIAL_001"
        },
        {
          "_type": "constant",
          "_name": "OVERLAY_CACHE_MAX_AGE_MS",
          "_source": "knowledge.know",
          "value": 5000,
          "unit": "milliseconds",
          "file": "src/renderer.py:12",
          "calibrates": [
            "AnimationRenderer",
            "OverlayCache"
          ],
          "why": "5 second TTL prevents stale overlay sprites from being reused if the user is idle. If a message takes longer than 5s to generate (rare: ElevenLabs timeout), the cache would contain orphaned sprites that no longer match the audio. TTL evicts them safely.",
          "valid_range": "2000 to 10000",
          "recalibrate_when": "ElevenLabs p99 generation latency exceeds 4s",
          "regime": "cache_eviction"
        },
        {
          "_type": "guide",
          "_name": "MESSAGE_PIPELINE_GUIDE",
          "_source": "knowledge.know",
          "_tags": [
            "@gotcha(\"Never add caching to the TTS alignment result \u2014 alignment is request-specific and cannot be reused across messages\")"
          ],
          "for": "MESSAGE_PIPELINE",
          "audience": "new_agent",
          "entry_point": "FrontendHandler",
          "workflow": "User submits \u2192 FrontendHandler clears state \u2192 MessageProcessor calls LLM \u2192 TTSService generates audio + phoneme alignment \u2192 AnimationRenderer composites overlays \u2192 client receives audio first, then frames",
          "critical_first": "Socket emit order is non-negotiable: audio message BEFORE frame messages. See concept AudioVideoSyncPrinciple. This is human perception physics, not a style preference.",
          "read_before_touching": {
            "FrontendHandler": "concept AsyncCacheContention, lesson CACHE_RACE_001",
            "TTSService": "concept PhonemeAlignmentCompleteness, lesson ALIGNMENT_PARTIAL_001",
            "AnimationRenderer": "concept AudioVideoSyncPrinciple, lesson AV_DESYNC_001"
          },
          "see_first": [
            "AudioVideoSyncPrinciple",
            "AsyncCacheContention",
            "PhonemeAlignmentCompleteness"
          ],
          "mock_mode": "Set env.MOCK_MODE=true to bypass ElevenLabs and LLM. Flow branches to mock_response step. Zero cost, full animation pipeline still runs."
        }
      ]
    },
