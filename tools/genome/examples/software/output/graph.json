        "source_lines": "def test_no_direct_emit():\n    \"\"\"Verifies no module calls socket.emit() outside SocketEventBus.\"\"\"\n    import ast\n    import pathlib\n    src_dir = pathlib.Path(__file__).parent\n    for py_file in src_dir.glob('**/*.py'):\n        if py_file.name == 'handler.py':\n            continue\n        tree = ast.parse(py_file.read_text())\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Call):\n                if hasattr(node.func, 'attr') and node.func.attr == 'emit':\n                    if hasattr(node.func.value, 'id') and node.func.value.id == 'socket':\n                        raise AssertionError(\n                            f\"Direct socket.emit() found in {py_file} line {node.lineno}. \"\n                            f\"Use SocketEventBus. See invariant NO_DIRECT_EMIT.\"\n                        )",
