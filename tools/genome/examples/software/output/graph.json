      "_source": "flows.know",
      "date": "2026-02-01",
      "severity": "warning",
      "in": "USER_MESSAGE_FLOW.generate_speech",
      "what": "Last 2-3 phonemes of sentence had wrong lip shape",
      "why": "Animation started before ElevenLabs alignment API returned final phonemes",
      "fix": "Added completion check — animation pipeline only starts after alignment.is_complete == true",
      "invariant": "Phoneme alignment MUST have is_complete == true before AnimationRenderer.selectLipSyncSprites()",
      "verified_by": "test_alignment_complete_before_animate"
    },
