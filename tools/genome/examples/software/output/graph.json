    "USER_MESSAGE_FLOW": {
      "_type": "flow",
      "_name": "USER_MESSAGE_FLOW",
      "_source": "flows.know",
      "_steps": [
        {
          "_name": "cleanup",
          "_target": "process",
          "_tags": [
            "@gotcha(\"clearOverlayCache MUST be awaited — see lesson CACHE_RACE_001\")"
          ],
          "actor": "FrontendHandler",
          "does": [
            "stopAudio",
            "clearOverlayCache",
            "resetAnimationState"
          ],
          "on_fail": "retry",
          "_next": "process"
        },
        {
          "_name": "process",
          "_target": "generate_speech",
          "actor": "MessageProcessor",
          "does": [
            "saveMessageToDatabase",
            "callLLM"
          ],
          "condition": "env.MOCK_MODE",
          "on_fail": "DatabaseError",
          "_next": "generate_speech"
        },
        {
          "_name": "mock_response",
          "_target": "done",
          "_tags": [
            "@why(\"zero-cost testing path — no ElevenLabs or LLM calls\")"
          ],
          "actor": "MessageProcessor",
          "does": [
            "loadMockAlignment",
            "emitMockFrames"
          ],
          "_next": "done"
        },
        {
          "_name": "generate_speech",
          "_target": "animate",
          "_tags": [
            "@gotcha(\"alignment MUST complete fully before animation starts — partial alignment causes lip desync\")"
          ],
          "actor": "TTSService",
          "does": [
            "generateTTS",
            "extractPhonemeAlignment"
          ],
          "timing": "alignment extraction adds ~200ms",
          "on_fail": "FallbackTTS",
          "_next": "animate"
        },
        {
          "_name": "animate",
          "_target": "done",
          "_tags": [
            "@gotcha(\"emit order matters: audio first, then frames — reversed order causes AV desync\")"
          ],
          "actor": "AnimationRenderer",
          "does": [
            "selectLipSyncSprites",
            "compositeOverlay",
            "emitFramesToClient"
          ],
          "_next": "done"
        }
      ],
      "description": "Full round-trip from user message to animated response",
      "trigger": "UserSubmitsMessage"
    },
    "TRANSPORT_PROTOCOL": {
      "_type": "decision",
      "_name": "TRANSPORT_PROTOCOL",
      "_source": "flows.know",
      "_options": [
        {
          "_name": "WebRTC",
          "_target": "rejected",
          "reason": "Latency 200ms+ at above 500 concurrent users in load test",
          "evidence": "perf_test_webrtc_v1",
          "tradeoffs": [
            "no_server_required",
            "supports_p2p"
          ],
          "reconsider_if": "context.requires_p2p",
          "_status": "rejected"
        },
        {
          "_name": "SocketIO",
          "_target": "chosen",
          "reason": "Latency under 50ms at 1000 concurrent in production",
          "evidence": "perf_test_socketio_v2",
          "tradeoffs": [
            "requires_server",
            "no_p2p"
          ],
          "revisit_when": "concurrent_users",
          "_status": "chosen"
        }
      ],
      "problem": "Real-time bidirectional communication between server and client",
      "context": [
        "high_concurrency",
        "server_mediated",
        "cross_platform",
        "low_latency_required"
      ]
    },
    "TTS_PROVIDER": {
      "_type": "decision",
      "_name": "TTS_PROVIDER",
      "_source": "flows.know",
      "_options": [
        {
          "_name": "GoogleTTS",
          "_target": "rejected",
          "reason": "No phoneme-level alignment output — cannot drive lip sync",
          "reconsider_if": "Google_adds_alignment_API",
          "_status": "rejected"
        },
        {
          "_name": "AzureTTS",
          "_target": "rejected",
          "reason": "Alignment format incompatible with our animation pipeline",
          "_status": "rejected"
        },
        {
          "_name": "ElevenLabs",
          "_target": "chosen",
          "reason": "Character-level alignment output, natural prosody, low latency",
          "tradeoffs": [
            "cost_per_character",
            "rate_limits"
          ],
          "revisit_when": "monthly_spend",
          "_status": "chosen"
        }
      ],
      "problem": "Text-to-speech with phoneme alignment for lip sync",
      "context": [
        "lip_sync_required",
        "natural_prosody",
        "cost_sensitive"
      ]
    },
    "LIP_SYNC_AXIS_SYSTEM": {
      "_type": "decision",
      "_name": "LIP_SYNC_AXIS_SYSTEM",
      "_source": "flows.know",
      "_options": [
        {
          "_name": "JXM_system",
          "_target": "rejected",
          "reason": "J/X/M axes conflate visually distinct movements, hard to tune",
          "tradeoffs": [
            216,
            "_sprites_already_generated",
            "production_stable"
          ],
          "reconsider_if": "false",
          "_status": "rejected"
        },
        {
          "_name": "JSLT_system",
          "_target": "chosen",
          "reason": "J/S/L/T axes map to independent articulators — jaw, smile, lip seal, tuck",
          "tradeoffs": [
            160,
            "_sprites_needed",
            "not_yet_in_production"
          ],
          "revisit_when": "sentence_test_suite_passes",
          "_status": "chosen"
        }
      ],
      "problem": "Axis system for controlling lip shape sprites",
      "context": [
        "sprite_based",
        "must_cover_all_english_phonemes",
        "agent_generated"
      ]
    },
    "CACHE_RACE_001": {
      "_type": "lesson",
      "_name": "CACHE_RACE_001",
      "_source": "flows.know",
      "date": "2026-01-15",
      "severity": "critical",
      "in": "USER_MESSAGE_FLOW.cleanup",
      "what": "Animation frames from previous message rendered over new message audio",
      "why": "clearOverlayCache() was called but not awaited — async function returned immediately while cache was still populated",
      "fix": "Added await to clearOverlayCache() call in FrontendHandler.handleMessage()",
      "invariant": "OverlayCache MUST be fully empty before audio playback begins",
      "verified_by": "test_cache_clear_before_audio"
    },
    "AV_DESYNC_001": {
      "_type": "lesson",
      "_name": "AV_DESYNC_001",
      "_source": "flows.know",
      "date": "2026-01-22",
      "severity": "critical",
      "in": "USER_MESSAGE_FLOW.animate",
      "what": "Video frames arrived at client before audio — first 200ms of speech showed neutral face",
      "why": "emit order in AnimationRenderer was frames first, then audio",
      "fix": "Swapped emit order: audio emitted first, frames follow in subsequent socket messages",
      "invariant": "Audio socket message MUST be emitted before frame messages in every response",
      "verified_by": "test_av_emit_order"
    },
    "ALIGNMENT_PARTIAL_001": {
      "_type": "lesson",
