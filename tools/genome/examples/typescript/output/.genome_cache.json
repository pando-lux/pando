        {
          "_type": "decision",
          "_name": "TypeSafeEvents",
          "_source": "architecture.know",
          "_options": [
            {
              "_name": "GenericEventBus",
              "_target": "chosen",
              "reason": "EventBus<EventMap> with a mapped type interface ensures emit() and on() share the same payload type per event name. Compile-time safety, zero runtime cost.",
              "evidence": "src/events.ts demonstrates the pattern with TaskEventMap",
              "tradeoffs": [
                "requires_central_event_map",
                "verbose_generics"
              ],
              "_status": "chosen"
            },
            {
              "_name": "StringEvents",
              "_target": "rejected",
              "reason": "Untyped string events (bus.emit('task:created', data)) have no compile-time safety. Payload mismatches only caught at runtime.",
              "tradeoffs": [
                "no_type_safety",
                "easy_to_mistype_event_names"
              ],
              "_status": "rejected"
            }
          ],
          "problem": "How to enforce type safety on event payloads across publishers and subscribers?",
          "context": [
            "typescript",
            "event_driven"
          ],
          "revisit_when": "project moves to a framework with built-in typed events (e.g., tRPC subscriptions)"
        },
        {
          "_type": "lesson",
          "_name": "STORE_MAP_ORDERING",
          "_source": "architecture.know",
          "date": "2026-02-20",
          "severity": "warning",
          "in": "TaskStore",
          "what": "Tasks returned by getByStatus() were in insertion order, not creation date order",
          "why": "JavaScript Map preserves insertion order, which matches creation order only if tasks are never updated. Updates that delete+re-insert change the order.",
          "fix": "Added explicit sort by createdAt after Map.values() collection",
          "invariant": "All query methods on TaskStore must sort results by createdAt descending",
          "verified_by": "test_store_ordering"
        },
        {
          "_type": "test",
          "_name": "test_store_ordering",
          "_source": "architecture.know",
          "validates": "STORE_MAP_ORDERING",
          "type": "unit",
          "location": "src/store.test.ts:1",
          "status": "passing",
          "last_run": "2026-02-20",
          "description": "Verify getByStatus returns tasks sorted by createdAt descending after updates"
        },
        {
          "_type": "test",
          "_name": "test_event_type_safety",
          "_source": "architecture.know",
          "validates": "TypeSafeEvents",
          "type": "unit",
          "location": "src/events.test.ts:1",
          "status": "passing",
          "last_run": "2026-02-20",
          "description": "Verify EventBus enforces correct payload types at compile time"
        },
        {
          "_type": "constant",
          "_name": "MAX_TASKS_PER_USER",
          "_source": "architecture.know",
          "value": 100,
          "unit": "tasks",
          "file": "src/service.ts:3",
          "calibrates": "TaskService",
          "why": "100 is the practical limit for a single user dashboard. Above 100, UI pagination becomes mandatory and query performance degrades on the in-memory store.",
          "valid_range": "50 to 500",
          "recalibrate_when": "storage moves from in-memory Map to a database with pagination"
        },
