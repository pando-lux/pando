  "nodes": {
    "EMPLOYEE_ONBOARDING": {
      "_type": "blueprint",
      "_name": "EMPLOYEE_ONBOARDING",
      "_source": "onboarding.know",
      "description": "End-to-end process for onboarding new employees from offer acceptance to day-30",
      "status": "active",
      "domain": "hr",
      "owner": "HR_Department",
      "contains": [
        "HR_Manager",
        "IT_Department",
        "Direct_Manager",
        "NewHire"
      ]
    },
