      "_type": "entity",
      "_name": "HR_Manager",
      "_source": "onboarding.know",
      "type": "role",
      "blueprint": "EMPLOYEE_ONBOARDING"
    },
    "IT_Department": {
      "_type": "entity",
      "_name": "IT_Department",
      "_source": "onboarding.know",
      "type": "department",
      "blueprint": "EMPLOYEE_ONBOARDING"
    },
    "Direct_Manager": {
      "_type": "entity",
      "_name": "Direct_Manager",
      "_source": "onboarding.know",
      "type": "role",
      "blueprint": "EMPLOYEE_ONBOARDING"
    },
