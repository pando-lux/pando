      "_type": "entity",
      "_name": "NewHire",
      "_source": "onboarding.know",
      "type": "person",
      "blueprint": "EMPLOYEE_ONBOARDING"
    },
    "HR_Department": {
      "_type": "entity",
      "_name": "HR_Department",
      "_source": "onboarding.know",
      "type": "department",
      "blueprint": "EMPLOYEE_ONBOARDING"
    },
    "ComplianceSystem": {
      "_type": "entity",
      "_name": "ComplianceSystem",
      "_source": "onboarding.know",
      "type": "system",
      "description": "Access control system that gates customer data behind compliance completion"
    },
    "Buddy": {
      "_type": "entity",
      "_name": "Buddy",
      "_source": "onboarding.know",
      "type": "role",
      "blueprint": "EMPLOYEE_ONBOARDING",
      "description": "Assigned peer who guides the new hire through their first week"
    },
    "OfferAccepted": {
      "_type": "entity",
      "_name": "OfferAccepted",
      "_source": "onboarding.know",
      "type": "event",
      "description": "Trigger: candidate formally accepts job offer — initiates onboarding process"
    },
    "NEW_HIRE_ONBOARDING": {
      "_type": "flow",
      "_name": "NEW_HIRE_ONBOARDING",
      "_source": "onboarding.know",
      "_steps": [
        {
          "_name": "pre_arrival",
          "_target": "day_one",
          "_tags": [
            "@gotcha(\"IT accounts MUST be ready before day-one — verify 2 days early, not morning of\")"
          ],
          "actor": [
            "HR_Manager",
            "IT_Department"
          ],
          "does": [
            "sendWelcomeEmail",
            "setupWorkstation",
            "createSystemAccounts",
            "assignBuddy"
          ],
          "timing": "1 week before start date",
          "on_fail": "escalate_to",
          "_next": "day_one"
        },
        {
          "_name": "day_one",
          "_target": "week_one_training",
          "_tags": [
            "@gotcha(\"Do NOT give building access card until background check clears — compliance requirement\")"
          ],
          "actor": [
            "HR_Manager",
            "Direct_Manager"
          ],
          "does": [
            "officeTour",
            "introToTeam",
            "systemAccessVerification",
            "completePaperwork"
          ],
          "condition": "role.requires_clearance",
          "_next": "week_one_training"
        },
        {
          "_name": "week_one_training",
          "_target": "compliance_training",
          "actor": [
            "Direct_Manager",
            "Buddy"
          ],
          "does": [
            "roleSpecificToolsOrientation",
            "meetKeyStakeholders",
            "firstTaskAssignment"
          ],
          "timing": "days 2-5",
          "_next": "compliance_training"
        },
        {
          "_name": "compliance_training",
          "_target": "active",
          "_tags": [
            "@gotcha(\"Customer data access is BLOCKED by ComplianceSystem until all modules pass — do not promise access before training\")"
          ],
          "actor": [
            "NewHire",
            "ComplianceSystem"
          ],
          "does": [
            "completeDataPrivacyModule",
            "completeSecurityModule",
            "completeHarassmentModule"
          ],
          "timing": "must complete within first 5 days",
          "on_fail": "escalate_to",
          "_next": "active"
        },
        {
          "_name": "active",
          "_target": "thirty_day_review",
          "actor": "NewHire",
          "timing": "days 6-29",
          "does": [
            "ongoingWork",
            "weeklyCheckIn"
          ],
          "_next": "thirty_day_review"
        },
        {
          "_name": "thirty_day_review",
          "_target": "done",
          "_tags": [
            "@gotcha(\"If 30-day review reveals poor fit, HR must be looped in BEFORE manager has direct conversation — legal requirement\")"
          ],
          "actor": [
            "HR_Manager",
            "Direct_Manager"
          ],
          "does": [
            "performanceCheck",
            "cultureFitAssessment",
            "adjustPlanIfNeeded",
            "confirmPermanentStatus"
          ],
          "_next": "done"
        }
      ],
      "description": "Full onboarding journey from offer acceptance to 30-day review",
      "trigger": "OfferAccepted"
    },
    "REMOTE_VS_IN_OFFICE_FIRST_MONTH": {
      "_type": "decision",
      "_name": "REMOTE_VS_IN_OFFICE_FIRST_MONTH",
      "_source": "onboarding.know",
      "_options": [
        {
          "_name": "fully_remote_first_month",
          "_target": "rejected",
          "reason": "Exit survey 2025 Q4: remote-first hires reported feeling disconnected — 40% higher 90-day churn",
          "evidence": "hr_exit_survey_2025_q4",
          "reconsider_if": "team.is_fully_distributed",
          "_status": "rejected"
        },
        {
          "_name": "hybrid_first_month",
          "_target": "chosen",
          "reason": "3 days in-office per week in first month improves 90-day retention by 23%",
          "evidence": "hr_retention_study_2025",
          "tradeoffs": [
            "requires_office_space",
            "harder_for_distant_hires"
          ],
          "revisit_when": "office_capacity",
          "_status": "chosen"
        }
      ],
      "problem": "Should new hires work remotely or in-office during their first month?",
      "context": [
        "retention_sensitive",
        "culture_building",
        "remote_work_policy"
      ]
    },
    "BUDDY_ASSIGNMENT_TIMING": {
      "_type": "decision",
      "_name": "BUDDY_ASSIGNMENT_TIMING",
      "_source": "onboarding.know",
      "_options": [
        {
          "_name": "assign_on_day_one",
          "_target": "rejected",
          "reason": "Day-one is chaotic — buddy and new hire both overwhelmed, interactions are rushed",
          "_status": "rejected"
        },
        {
          "_name": "assign_before_arrival",
          "_target": "chosen",
          "reason": "Pre-arrival assignment gives buddy time to prepare and new hire a contact before day-one",
          "tradeoffs": [
            "buddy_notified_week_early"
          ],
          "revisit_when": "buddy_program_participation_rate",
          "_status": "chosen"
        }
      ],
      "problem": "When should a buddy be assigned to the new hire?",
      "context": [
        "first_week_experience",
        "buddy_availability"
      ]
    },
    "IT_ACCESS_DELAY_001": {
      "_type": "lesson",
      "_name": "IT_ACCESS_DELAY_001",
      "_source": "onboarding.know",
      "date": "2026-01-08",
      "severity": "critical",
      "in": "NEW_HIRE_ONBOARDING.pre_arrival",
      "what": "Three new hires had no laptop access on their first day — sat idle for half the day",
      "why": "IT account request submitted only 2 days before start. Active Directory propagation takes 48h.",
      "fix": "IT request now triggered 7 days before start date. HR checklist updated with 2-day verification step.",
      "invariant": "IT account request must be submitted minimum 7 days before start date",
      "verified_by": "test_it_request_timing"
    },
    "COMPLIANCE_DATA_ACCESS_001": {
      "_type": "lesson",
      "_name": "COMPLIANCE_DATA_ACCESS_001",
      "_source": "onboarding.know",
      "date": "2026-01-20",
      "severity": "critical",
      "in": "NEW_HIRE_ONBOARDING.compliance_training",
      "what": "New hire given customer data dashboard login before completing compliance training",
      "why": "Direct manager bypassed ComplianceSystem by sharing own credentials — thought training was 'just a formality'",
      "fix": "System access is now technically blocked, not just policy-blocked. ComplianceSystem updated. Manager reminded of legal obligation.",
      "invariant": "Customer data access must be technically impossible until ComplianceSystem confirms training completion",
      "verified_by": "test_compliance_gate"
    },
    "THIRTY_DAY_LEGAL_001": {
      "_type": "lesson",
      "_name": "THIRTY_DAY_LEGAL_001",
      "_source": "onboarding.know",
      "date": "2026-02-01",
      "severity": "critical",
      "in": "NEW_HIRE_ONBOARDING.thirty_day_review",
      "what": "Manager had termination conversation with new hire without HR present — created legal liability",
      "why": "Manager didn't know protocol: HR must be looped in before any performance conversation in first 90 days",
      "fix": "Added explicit step in 30-day review checklist. Manager training updated. HR now auto-notified when 30-day review is scheduled.",
      "invariant": "HR must be notified minimum 48h before any performance conversation in first 90 days",
      "verified_by": "test_hr_notification_before_review"
    },
    "COMPLIANCE_BEFORE_DATA_ACCESS": {
      "_type": "invariant",
      "_name": "COMPLIANCE_BEFORE_DATA_ACCESS",
      "_source": "onboarding.know",
      "rule": "NewHire must have ComplianceSystem approval before accessing any customer data",
      "applies_to": [
        "NewHire",
        "ComplianceSystem"
      ],
      "enforced_by": "test_compliance_gate",
      "severity": "critical"
    },
    "HR_PRESENT_FOR_PERFORMANCE": {
      "_type": "invariant",
      "_name": "HR_PRESENT_FOR_PERFORMANCE",
      "_source": "onboarding.know",
      "rule": "HR must be notified 48h before any performance conversation in first 90 days",
      "applies_to": [
        "Direct_Manager",
        "HR_Manager"
      ],
      "enforced_by": "test_hr_notification_before_review",
      "severity": "critical"
    },
    "test_it_request_timing": {
      "_type": "test",
      "_name": "test_it_request_timing",
      "_source": "onboarding.know",
      "validates": "IT_ACCESS_DELAY_001.invariant",
      "type": "manual",
      "location": "hr_checklist.md: Pre-arrival section, step 2",
      "status": "passing",
      "description": "Verify IT ticket created date is minimum 7 days before start date",
      "last_run": "2026-02-18"
    },
    "test_compliance_gate": {
      "_type": "test",
      "_name": "test_compliance_gate",
      "_source": "onboarding.know",
      "validates": "COMPLIANCE_BEFORE_DATA_ACCESS",
      "type": "integration",
      "location": "system/compliance_gate_test.py:15",
      "status": "passing",
      "description": "Verify ComplianceSystem blocks dashboard login until all modules marked complete",
      "last_run": "2026-02-20"
    },
    "test_hr_notification_before_review": {
      "_type": "test",
      "_name": "test_hr_notification_before_review",
      "_source": "onboarding.know",
      "validates": "THIRTY_DAY_LEGAL_001.invariant",
      "type": "manual",
      "location": "hr_checklist.md: 30-day review section, step 1",
      "status": "passing",
      "description": "Verify HR calendar invite sent 48h+ before review meeting",
      "last_run": "2026-02-15"
    }
