    "BakerDecidesToBake": {
      "_type": "entity",
      "_name": "BakerDecidesToBake",
      "_source": "sourdough.know",
      "type": "event",
      "description": "Trigger: baker decides to bake a loaf (initiates 24-36 hour process)"
    },
    "BAKE_SOURDOUGH": {
      "_type": "flow",
      "_name": "BAKE_SOURDOUGH",
      "_source": "sourdough.know",
      "_steps": [
        {
          "_name": "feed_starter",
          "_target": "check_starter_readiness",
          "_tags": [
            "@gotcha(\"Starter must be at PEAK activity — dome-shaped, doubled in size, bubbly throughout\")"
          ],
          "actor": "Baker",
          "does": [
            "discardHalfStarter",
            "addEqualPartsFlourAndWater"
          ],
          "timing": "12 hours before mixing dough",
          "_next": "check_starter_readiness"
        },
        {
          "_name": "check_starter_readiness",
          "_target": "mix_dough",
          "_tags": [
            "@gotcha(\"Float test: drop small amount in water. Float = ready. Sink = needs more time.\")"
          ],
          "actor": "Baker",
          "does": [
            "float_test"
          ],
          "condition": "starter.sinks",
          "_next": "mix_dough"
        },
        {
          "_name": "wait_longer",
          "_target": "check_starter_readiness",
          "actor": "Time",
          "timing": "2-4 more hours",
          "_next": "check_starter_readiness"
        },
        {
          "_name": "mix_dough",
          "_target": "autolyse",
          "_tags": [
            "@gotcha(\"Add salt 30 minutes after flour+water — premature salt slows gluten development\")"
          ],
          "actor": "Baker",
          "does": [
            "combineFlourAndWater",
            "addStarter",
            "addSalt"
          ],
          "timing": "10 minutes mixing",
          "_next": "autolyse"
        },
        {
          "_name": "autolyse",
          "_target": "bulk_fermentation",
          "_tags": [
            "@why(\"Autolyse reduces mixing time needed and improves extensibility\")"
          ],
          "actor": "Time",
          "timing": "30-60 minutes rest — gluten develops without kneading",
          "_next": "bulk_fermentation"
        },
        {
          "_name": "bulk_fermentation",
          "_target": "shape",
          "_tags": [
            "@gotcha(\"Temperature is the biggest variable — 65F doubles time, 85F risks over-fermentation\")",
            "@gotcha(\"Bulk is done when dough has grown 75-100%, feels jiggly, and holds its shape briefly\")"
          ],
          "actor": [
            "Baker",
            "Time"
          ],
          "does": [
            "stretchAndFoldEvery30min",
            "watchForDoubling"
          ],
          "timing": "4-6 hours at 75F / 24C",
          "_next": "shape"
        },
        {
          "_name": "shape",
          "_target": "cold_proof",
          "_tags": [
            "@gotcha(\"Tension on the surface is critical — slack shaping = flat bread with no oven spring\")"
          ],
          "actor": "Baker",
          "does": [
            "preshape",
            "benchRest15min",
            "finalShape",
            "placeInBanneton"
          ],
          "_next": "cold_proof"
        },
        {
          "_name": "cold_proof",
          "_target": "score_and_bake",
          "_tags": [
            "@gotcha(\"Do NOT exceed 16 hours — over-proofed dough collapses in oven\")",
            "@why(\"Cold retard slows fermentation, develops flavor, and makes scoring easier\")"
          ],
          "actor": "Refrigerator",
          "timing": "8-16 hours at 38F / 3C",
          "_next": "score_and_bake"
        },
        {
          "_name": "score_and_bake",
          "_target": "done",
          "_tags": [
            "@gotcha(\"Dutch oven MUST be preheated with the oven — cold vessel = no oven spring\")",
            "@gotcha(\"Score immediately before baking — scored dough left out deflates\")"
          ],
          "actor": [
            "Baker",
            "Oven"
          ],
          "does": [
            "preheatDutchOven500F",
            "scoreDough",
            "bakeCovered20min",
            "bakeUncovered20min"
          ],
          "timing": "20 min covered at 500F, 20 min uncovered at 450F",
          "_next": "done"
        }
      ],
      "description": "Full baking process from starter feed to finished loaf",
      "trigger": "BakerDecidesToBake"
    },
    "HYDRATION_LEVEL": {
      "_type": "decision",
      "_name": "HYDRATION_LEVEL",
      "_source": "sourdough.know",
      "_options": [
        {
          "_name": "high_hydration_75plus",
          "_target": "rejected",
          "reason": "75%+ hydration spreads during shaping for beginner skill level",
          "reconsider_if": "baker.skill_level",
          "_status": "rejected"
        },
        {
          "_name": "medium_hydration_70",
          "_target": "chosen",
          "reason": "68-72% hydration is forgiving, produces open crumb, holds shape during shaping",
          "tradeoffs": [
            "slightly_less_open_crumb_than_75percent"
          ],
          "revisit_when": "baker.has_completed_10_successful_loaves",
          "_status": "chosen"
        }
      ],
      "problem": "What flour-to-water ratio to use for consistent results",
      "context": [
        "beginner_friendly",
        "open_crumb_desired",
        "home_oven"
      ]
    },
    "FLOUR_TYPE": {
      "_type": "decision",
      "_name": "FLOUR_TYPE",
      "_source": "sourdough.know",
      "_options": [
        {
          "_name": "all_purpose",
          "_target": "rejected",
          "reason": "Lower protein (10-11%) produces slack dough that doesn't hold shape",
          "reconsider_if": "bread_flour_unavailable",
          "_status": "rejected"
        },
        {
          "_name": "bread_flour",
          "_target": "chosen",
          "reason": "12-13% protein develops strong gluten network — holds shape and produces oven spring",
          "tradeoffs": [
            "slightly_less_flavor_than_whole_wheat"
          ],
          "_status": "chosen"
        },
        {
          "_name": "whole_wheat_blend",
          "_target": "pending",
          "reason": "10-20% whole wheat adds flavor and nutrients, accelerates fermentation",
          "reconsider_if": "baker.wants_more_flavor_complexity",
          "_status": "pending"
        }
      ],
      "problem": "Which flour for best structure and flavor",
      "context": [
        "home_baking",
        "widely_available"
      ]
    },
    "OVERPROOFED_LOAF_001": {
      "_type": "lesson",
      "_name": "OVERPROOFED_LOAF_001",
      "_source": "sourdough.know",
      "date": "2026-01-10",
      "severity": "critical",
      "in": "BAKE_SOURDOUGH.cold_proof",
      "what": "Loaf came out completely flat with no oven spring and dense crumb",
      "why": "Left in refrigerator for 22 hours — fermentation continued past peak despite cold",
      "fix": "Strict 16-hour maximum. Do poke test before baking: slow spring-back = ready, no spring-back = over-proofed",
      "invariant": "Cold proof must not exceed 16 hours. Poke test must show slow spring-back.",
      "verified_by": "test_proof_timing"
    },
    "FLAT_LOAF_NO_SCORE_001": {
      "_type": "lesson",
      "_name": "FLAT_LOAF_NO_SCORE_001",
      "_source": "sourdough.know",
      "date": "2026-01-18",
      "severity": "warning",
      "in": "BAKE_SOURDOUGH.score_and_bake",
      "what": "Loaf burst on the side instead of expanding upward through the score",
      "why": "Scoring was too shallow (2mm instead of 5mm) — dough found weakest point and burst there",
      "fix": "Score at 30-45 degree angle, minimum 5mm deep, in one confident stroke",
      "invariant": "Score must be minimum 5mm deep at 30-45 degree angle",
      "verified_by": "test_score_depth_visual"
    },
    "DENSE_CRUMB_PREMATURE_SALT_001": {
      "_type": "lesson",
      "_name": "DENSE_CRUMB_PREMATURE_SALT_001",
      "_source": "sourdough.know",
      "date": "2026-02-02",
      "severity": "warning",
      "in": "BAKE_SOURDOUGH.mix_dough",
      "what": "Dense crumb with poor rise despite correct fermentation times",
      "why": "Salt added at same time as flour and water — inhibited gluten development from the start",
      "fix": "Add flour+water first, rest 30 minutes, then add salt. Gluten network established before salt inhibition.",
      "invariant": "Salt must be added minimum 30 minutes after flour and water are combined",
      "verified_by": "test_salt_timing"
    },
    "STARTER_MUST_BE_ACTIVE": {
      "_type": "invariant",
      "_name": "STARTER_MUST_BE_ACTIVE",
      "_source": "sourdough.know",
      "rule": "StarterCulture must pass float test before use in dough",
      "applies_to": [
        "Dough",
