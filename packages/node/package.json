{
  "name": "pando",
  "version": "0.2.0",
  "description": "Pando — The Open Network. Run a decentralized, AI-managed P2P node.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pando": "bin/pando.cjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && git rev-parse HEAD > dist/.build-commit",
    "lint:imports": "node ../../scripts/check-imports.mjs",
    "test": "node --test dist/tests/api.test.js",
    "start": "node --loader ts-node/esm src/cli.ts",
    "supervisor": "node dist/supervisor.js",
    "clean": "rm -rf dist",
    "postinstall": "find node_modules/node-pty -name spawn-helper -exec chmod +x {} \\; 2>/dev/null || true"
  },
  "keywords": [
    "p2p",
    "decentralized",
    "network",
    "ai",
    "libp2p",
    "pando",
    "lux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pando-lux/pando.git",
    "directory": "packages/node"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.994.0",
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/s3-request-presigner": "^3.994.0",
    "@chainsafe/libp2p-gossipsub": "^14.0.0",
    "@chainsafe/libp2p-noise": "^16.0.0",
    "@chainsafe/libp2p-yamux": "^7.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@libp2p/bootstrap": "^11.0.0",
    "@libp2p/circuit-relay-v2": "^4.1.3",
    "@libp2p/crypto": "^5.0.0",
    "@libp2p/dcutr": "^3.0.10",
    "@libp2p/identify": "^3.0.0",
    "@libp2p/kad-dht": "^14.0.0",
    "@libp2p/mdns": "^11.0.0",
    "@libp2p/peer-id": "^5.0.0",
    "@libp2p/tcp": "^10.0.0",
    "@libp2p/websockets": "^9.0.0",
    "@pando/ledger": "*",
    "@pando/shared": "*",
    "fastify": "^5.7.4",
    "it-length-prefixed": "^9.0.0",
    "it-pipe": "^3.0.0",
    "libp2p": "^2.4.0",
    "mongodb": "^6.12.0",
    "node-pty": "^1.0.0",
    "systray2": "^2.1.4",
    "uint8arrays": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
