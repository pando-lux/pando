# Pando Gateway Environment Variables
# Copy this to pando/packages/gateway/.env.local and fill in your values

PANDO_NODE_URL=http://localhost:4000

# OpenAI (for AI search fallback)
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Gemini (for AI search fallback)
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-lite
