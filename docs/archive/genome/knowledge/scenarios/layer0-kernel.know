# Layer 0 — Kernel Test Scenarios
# Migrated from legacy genome/flows/e2e-test-scenarios.md (Scenarios 1-11, 29, 38-40, 42)
# These MUST pass before testing any higher layer.

test IdentityNodeCreation {
  description: "Node starts, creates Ed25519 identity, persists across restarts. Same peerId on restart."
  validates: NODE_IDENTITY_PERSISTENCE
  type: e2e
  category: kernel
  mode: 1
  automatable: true
  steps: [
    "Start node with fresh --data-dir",
    "GET /v1/status — note peerId",
    "Verify identity file exists in data-dir/identities/",
    "Stop node, restart with same --data-dir",
    "GET /v1/status — compare peerId is identical"
  ]
  expected: "peerId identical across restarts. Identity file persisted on disk."
  status: passing
  @gotcha("Use --data-dir /tmp/pando-test to avoid polluting default ~/.pando")
}

test IdentityEncryptedPassword {
  description: "Encrypted identity with password. Correct password restores same peerId. Wrong password fails cleanly."
  validates: NODE_IDENTITY_PERSISTENCE
  type: e2e
  category: kernel
  mode: 1
  automatable: false
  steps: [
    "Start TUI with fresh --data-dir, enter password",
    "Note peerId from /status",
    "Stop, restart, enter correct password — verify same peerId",
    "Stop, restart, enter WRONG password — verify failure (no garbage identity)"
  ]
  expected: "Correct password = same peerId. Wrong password = clear error, no startup."
  status: passing
  @gotcha("TUI password prompt requires human interaction — not automatable")
}

test LedgerCheckBalance {
  description: "GET /v1/balance returns valid JSON with peerId, balance (non-negative), consistent with explicit peerId query."
  validates: LEDGER_INTEGRITY
  type: e2e
  category: kernel
  mode: 1
  automatable: true
  steps: [
    "GET /v1/balance on EC2-1",
    "GET /v1/balance?peerId=<EC2-1-peerId>",
    "Compare: both return same balance"
  ]
  expected: "JSON with peerId, balance (non-negative). Consistent with/without explicit peerId."
  status: passing
}

test LedgerTransferBetweenNodes {
  description: "Transfer 5 Lux between EC2-1 and EC2-2. Balances update correctly with relay fee. GossipSub propagates."
  validates: LEDGER_INTEGRITY
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, EC2-2"
  automatable: true
  steps: [
    "Record initial balances on both nodes",
    "POST /v1/transfer from EC2-1 to EC2-2 (5 Lux)",
    "Wait 5s for P2P sync",
    "Verify EC2-1 balance decreased by 5",
    "Verify EC2-2 balance increased by ~4.995 (minus 0.1% relay fee)"
  ]
  expected: "Balances update correctly. Transaction in ledger history. GossipSub propagated."
  status: passing
  @gotcha("Relay fee is 0.1% — EC2-2 receives 4.995 not 5.0")
}

test LedgerSyncAcrossThreeNodes {
  description: "After transfer, all 3 nodes (EC2-1, LS-1, Windows) converge on same balance within 10s."
  validates: LEDGER_SYNC
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, LS-1, Windows"
  automatable: true
  steps: [
    "Get starting balances for EC2-1's peerId from all 3 nodes",
    "Transfer 5 Lux from EC2-1 to EC2-2",
    "Wait 10s",
    "Query EC2-1's balance from all 3 nodes",
    "All 3 should show identical decreased balance"
  ]
  expected: "All 3 nodes converge on same balance within 10 seconds."
  status: passing
}

test P2PmDNSDiscovery {
  description: "Two local nodes discover each other via mDNS within 30 seconds (no bootstrap flag)."
  validates: P2P_DISCOVERY
  type: e2e
  category: kernel
  mode: 2
  automatable: true
  steps: [
    "Start Node A on port 4200 with fresh data-dir (no bootstrap)",
    "Start Node B on port 4201 with fresh data-dir (no bootstrap)",
    "Wait 30s for mDNS discovery",
    "GET /peers on both — each shows the other"
  ]
  expected: "Both nodes discover each other via mDNS within 30 seconds."
  status: passing
  @gotcha("mDNS only works on same LAN. Cannot test across cloud nodes.")
}

test P2PBootstrapConnection {
  description: "Local node connects to LS-1 via explicit --bootstrap flag within 15 seconds."
  validates: P2P_DISCOVERY
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "LS-1"
  automatable: true
  steps: [
    "Get LS-1 multiaddr from GET /onboard",
    "Start local node with --bootstrap <LS-1-multiaddr>",
    "Wait 15s",
    "GET /peers — LS-1 should appear"
  ]
  expected: "LS-1 appears in peers within 15 seconds. Additional peers via KadDHT possible."
  status: passing
}

test GovernanceCreateProposalAndVote {
  description: "Create proposal on EC2-1 (10 Lux stake), propagate to EC2-2, vote from EC2-2 and Windows, reach quorum."
  validates: GOVERNANCE_INTEGRITY
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, EC2-2, Windows"
  automatable: true
  steps: [
    "Verify EC2-1 balance >= 10 Lux",
    "POST /v1/governance/proposals on EC2-1",
    "Wait 10s for GossipSub propagation",
    "Verify proposal visible on EC2-2",
    "Vote approve from EC2-2",
    "Vote approve from Windows",
    "Check proposal status — vote counts, quorum reached"
  ]
  expected: "Proposal created, propagated via GossipSub, votes counted, quorum reached."
  status: passing
  @gotcha("10 Lux stake required. New identities with < 10 Lux cannot propose.")
}

test HealthMonitorStatus {
  description: "GET /v1/monitor/status returns uptime, peers, memory, cpu, ledger, agents, alerts. All fields present."
  validates: HEALTH_MONITORING
  type: e2e
  category: kernel
  mode: 1
  automatable: true
  steps: [
    "GET /v1/monitor/status on EC2-1",
    "Verify response has: uptime, peers, memory, cpu, ledger, agents, alerts",
    "Start fresh node, wait 2 min, verify same fields (0 agents, empty alerts)",
    "Verify uptime increases on subsequent calls"
  ]
  expected: "All fields present, no undefined/null. Uptime increasing."
  status: passing
}

test GuardrailsProtectedPathBlocked {
  description: "Writing to protected paths (identity.json, node source) returns 403. Identity file unchanged."
  validates: GUARDRAILS_ENFORCEMENT
  type: e2e
  category: kernel
  mode: 1
  automatable: true
  steps: [
    "POST write to ~/.pando/identity.json — expect 403",
    "POST write to /opt/pando/packages/node/src/index.js — expect 403",
    "Verify identity file unchanged",
    "Check guardrails log for audit trail"
  ]
  expected: "403 Forbidden. Protected files unchanged. Attempt logged."
  status: passing
}

test EmissionUptimeEpoch {
  description: "After 10-minute uptime epoch, balance increases by ~0.05 Lux. Witness signatures present. No double-mint."
  validates: EMISSION_CORRECTNESS
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, EC2-2, LS-1"
  automatable: true
  steps: [
    "Note EC2-1 balance at time T",
    "Wait 10+ minutes (one uptime epoch)",
    "Check EC2-1 balance — should increase by ~0.05 Lux (or 0.25 with 5x multiplier)",
    "Check emission log for witness signatures",
    "Verify emission fires once per epoch, not more"
  ]
  expected: "Balance increases by correct amount. Witnesses attested. No double-mint."
  status: passing
  @gotcha("Bootstrap fallback emission used if < 3 connected peers.")
}

test Mode1OfflineNodeWorks {
  description: "Disconnect network. Node still responds: /status, /balance, ledger READ. Transfer fails gracefully. Reconnects after restore."
  validates: MODE1_OFFLINE_RESILIENCE
  type: e2e
  category: kernel
  mode: 1
  automatable: true
  steps: [
    "Start node, verify /status with peers",
    "Disconnect network adapter",
    "Wait 30s for peer connections to drop",
    "GET /status — should still respond",
    "GET /balance — should return local balance",
    "POST /transfer — should fail gracefully (not crash)",
    "Reconnect network",
    "Wait 30s — verify peers reconnect"
  ]
  expected: "Node responsive offline. Layer 0 reads work. Transfers fail gracefully. Reconnects automatically."
  status: passing
  @gotcha("Use iptables or firewall rules for automation. Don't literally disconnect cable.")
}

test FullMeshAllFiveNodes {
  description: "All 5 nodes connected, each shows 3+ peers. Ledger fully synced (identical balance for same account)."
  validates: NETWORK_MESH_HEALTH
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, EC2-2, LS-1, LS-2, Windows"
  automatable: true
  steps: [
    "GET /peers on each of 5 nodes — each shows 3+ peers",
    "GET /network on EC2-1 — verify connected topology",
    "Query EC2-1's balance from all 5 nodes — all identical"
  ]
  expected: "Each node 3+ peers. Identical balance across all 5. No partitioned subgraphs."
  status: passing
  @gotcha("LS-2 (3.237.175.38) sometimes unreachable — may show 4 instead of 5.")
}

test BootstrapReconnect {
  description: "Restart LS-1 (PM2). Reconnects to known peers within 30 seconds via known-peers.json."
  validates: PEER_PERSISTENCE
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "LS-1, EC2-1, EC2-2"
  automatable: true
  steps: [
    "Verify LS-1 has peers",
    "PM2 restart LS-1",
    "At 30s mark: GET /peers — should show 2+ peers",
    "Verify known-peers.json loaded on startup"
  ]
  expected: "Reconnects within 30s. Known peers loaded from disk."
  status: passing
}

test LuxTransferChain {
  description: "EC2-1 → LS-1 (5 Lux) → Windows (2 Lux). Relay fees applied. All 3 nodes agree on final balances."
  validates: LEDGER_INTEGRITY
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, LS-1, Windows"
  automatable: true
  steps: [
    "Record starting balances for all 3 peerIds on all 3 nodes",
    "Transfer 5 Lux from EC2-1 to LS-1",
    "Wait 10s",
    "Transfer 2 Lux from LS-1 to Windows",
    "Wait 10s",
    "Verify all 3 nodes agree on final balances for all 3 accounts"
  ]
  expected: "EC2-1 -5, LS-1 +~3 (received 5, sent 2), Windows +~2. Relay fees applied. Ledger synced."
  status: passing
}

test NetworkPartitionRecovery {
  description: "Isolate LS-1 via iptables. Make transfers during isolation. Restore connectivity. LS-1 ledger re-syncs."
  validates: PARTITION_TOLERANCE
  type: e2e
  category: kernel
  mode: 2
  nodes_required: "EC2-1, EC2-2, LS-1"
  automatable: true
  steps: [
    "Record LS-1 and EC2-1 balances (identical)",
    "Block LS-1 → EC2-1/EC2-2 via iptables",
    "Wait 60s (LS-1 isolated)",
    "Make transfers on EC2-1 that LS-1 doesn't see",
    "Remove iptables rules",
    "Wait 30s for reconnection",
    "Check LS-1 balances — should match EC2-1 (missed txns reconciled)"
  ]
  expected: "LS-1 reconnects within 30s. Missed transactions reconciled. No duplicates."
  status: passing
  @gotcha("Use iptables -D to remove rules. Don't forget or LS-1 stays isolated forever.")
}
