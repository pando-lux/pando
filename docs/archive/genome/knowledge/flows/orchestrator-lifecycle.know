flow OrchestratorLifecycle {
  summary: "Project orchestrator lifecycle: creation → ticking → auto-dissolution. Orchestrators dissolve immediately when all workers are done/failed and inbox is empty. Fallback: dissolve after 3 min idle. Council self-check runs every 10th tick and enforces dissolution."
  trigger: ProjectCreation

  step project_created -> orchestrator_instantiated {
    actor: PandoNode
    what: "ensureProjectOrchestrator(projectId) creates DB record + live Orchestrator instance. Starts tick loop (30s for project, 60s for council)."
  }

  step orchestrator_instantiated -> active_phase {
    actor: Orchestrator
    what: "Orchestrator reads inbox, calls AI, spawns workers, manages build pipeline. Activity tracked via lastReportAt (updated on each message-processing tick)."
  }

  step active_phase -> all_workers_done {
    actor: Orchestrator
    what: "All workers report done/failed. Orchestrator clears currentFocus. If devops reported a deploy URL, auto-responds to user."
  }

  step all_workers_done -> immediate_dissolve {
    actor: Council
    what: "Council self-check (every 10th tick) scans project orchestrators. If all workers done/failed AND no unread messages → dissolve immediately. No waiting."
    @gotcha("The council dissolves OTHER orchestrators, not itself. Council never self-dissolves.")
    @gotcha("Persistent orchestrators (observer, qa-user) are EXEMPT from dissolution. Both the stale-check loop and OOM prevention loop skip orch.persistent === true. Without this guard, observer/qa-user get dissolved as 'stale' because they have 0 workers and their lastTickAt may be old during boot.")
  }

  step all_workers_done -> timeout_dissolve {
    actor: Council
    what: "Fallback: if no workers but inbox not empty, or workers still pending — dissolve after 3 min idle (no workers, lastActivity > 3 min ago)."
    @gotcha("Was 10 min — reduced to 3 min to prevent 20+ idle orchestrators piling up.")
  }

  step immediate_dissolve -> cleanup {
    actor: OrgManager
    what: "orgManager.dissolve(orchId) sets status='dissolved', stops tick timer, removes from liveOrchestrators map."
  }

  step timeout_dissolve -> cleanup {
    actor: OrgManager
    what: "Same dissolution path as immediate — just triggered by timeout instead of completion check."
  }

}
